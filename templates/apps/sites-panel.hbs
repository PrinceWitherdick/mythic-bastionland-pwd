<div class="bastionland-page bastionland-sites">
	<p class="bastionland-hint">{{localize "bastionland.sites.hint"}}</p>

	<div class="bastionland-sites__layout">
		<section class="bastionland-sites__controls">
			<div class="bastionland-sites__fields">
				<label for="{{rootId}}-name">{{localize "bastionland.sites.name"}}</label>
				<input id="{{rootId}}-name" type="text" name="name" value="{{name}}" placeholder="{{placeholder}}">
				<label for="{{rootId}}-seed">{{localize "bastionland.sites.seed"}}</label>
				<div class="bastionland-sites__seed">
					<input id="{{rootId}}-seed" type="text" name="seed" value="{{seed}}" spellcheck="false" autocomplete="off">
					<button type="button" class="bastionland-icon" data-action="reroll" data-tooltip="{{localize 'bastionland.sites.reroll'}}" aria-label="{{localize 'bastionland.sites.reroll'}}">
						<i class="fa-solid fa-dice" inert></i>
					</button>
				</div>
			</div>

			<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.sites.pointsHeading"}}</h3>
			<div class="bastionland-sites__counts">
				{{#each pointCounts}}
				<div class="bastionland-sites__count">
					<label for="{{@root.rootId}}-{{name}}" data-tooltip="{{hint}}">{{label}}</label>
					<input id="{{@root.rootId}}-{{name}}" class="bastionland-box" type="number" name="{{name}}" value="{{value}}" min="0" step="1">
				</div>
				{{/each}}
			</div>

			<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.sites.routesHeading"}}</h3>
			<div class="bastionland-sites__counts">
				{{#each routeCounts}}
				<div class="bastionland-sites__count">
					<label for="{{@root.rootId}}-{{name}}" data-tooltip="{{hint}}">{{label}}</label>
					<input id="{{@root.rootId}}-{{name}}" class="bastionland-box" type="number" name="{{name}}" value="{{value}}" min="0" step="1">
				</div>
				{{/each}}
			</div>

			<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.sites.entrancesHeading"}}</h3>
			<label class="bastionland-check">
				<input type="checkbox" name="entrance" {{checked entrance}}>
				<span class="bastionland-check__label">{{localize "bastionland.sites.entrance"}}</span>
			</label>
			<label class="bastionland-check">
				<input type="checkbox" name="hiddenEntrance" {{checked hiddenEntrance}}>
				<span class="bastionland-check__label">{{localize "bastionland.sites.hiddenEntrance"}}</span>
			</label>

			<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.sites.presetsHeading"}}</h3>
			<ul class="bastionland-choices bastionland-choices--inline">
				{{#each presets}}
				<li>
					<button type="button" class="bastionland-choice" data-action="preset" data-preset="{{key}}">{{label}}</button>
				</li>
				{{/each}}
			</ul>
		</section>

		<figure class="bastionland-sites__diagram">{{{diagram}}}</figure>
	</div>

	{{#if problems.length}}
	<ul class="bastionland-sites__problems">
		{{#each problems}}
		<li>{{this}}</li>
		{{/each}}
	</ul>
	{{/if}}

	<section class="bastionland-block">
		<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.sites.keyHeading"}}</h3>
		{{#if points.length}}
		<ol class="bastionland-sites__key">
			{{#each points}}
			<li>
				<span class="bastionland-sites__number">{{number}}</span>
				<strong>{{kindLabel}}</strong>{{#if entrances}} · {{entrances}}{{/if}}: {{routes}}
			</li>
			{{/each}}
		</ol>
		{{else}}
		<p class="bastionland-empty">{{localize "bastionland.sites.empty"}}</p>
		{{/if}}
	</section>

	<nav class="bastionland-toolbar" aria-label="{{localize 'bastionland.sites.title'}}">
		<button type="button" data-action="post"><i class="fa-solid fa-comment" inert></i> {{localize "bastionland.sites.post"}}</button>
		<button type="button" data-action="save"><i class="fa-solid fa-book-open" inert></i> {{localize "bastionland.sites.save"}}</button>
	</nav>
</div>
