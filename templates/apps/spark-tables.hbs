<div class="bastionland-page bastionland-spark">
	{{#if notice}}
	<p class="bastionland-chooser__notice">{{notice}}</p>
	{{/if}}

	<header class="bastionland-spark__header">
		<ul class="bastionland-choices bastionland-choices--inline">
			{{#each pages}}
			<li>
				<button type="button" class="bastionland-choice bastionland-pill{{#if active}} is-active{{/if}}" data-action="showPage" data-page="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
			</li>
			{{/each}}
		</ul>
		{{#if wild}}
		<p class="bastionland-hint">{{localize "bastionland.hexLore.wildHex.intro"}} {{wild.reference}}</p>
		{{else}}
		<p class="bastionland-hint">{{localize "bastionland.spark.hint"}}{{#if reference}} ({{reference}}){{/if}}</p>
		{{/if}}
		<div class="bastionland-spark__tools">
			<div class="bastionland-spark__checks">
				<label class="bastionland-check bastionland-spark__animate">
					<input type="checkbox" name="animate" {{checked animate}}>
					<span class="bastionland-check__label">{{localize "bastionland.spark.animate"}}</span>
				</label>
				{{!-- The Wilderness Hex page keeps what's taken by its own Save button, not roll by roll. --}}
				{{#unless wild}}
				<label class="bastionland-check bastionland-spark__animate" data-tooltip="{{localize "bastionland.spark.keepHint"}}">
					<input type="checkbox" name="keep" {{checked keep.checked}} {{disabled keep.disabled}}>
					<span class="bastionland-check__label">{{keep.label}}</span>
				</label>
				{{/unless}}
			</div>
			{{#unless notice}}{{#unless wild}}
			<button type="button" data-action="rollPerson" data-tooltip="{{localize "bastionland.people.rollHint"}}"><i class="fa-solid fa-user" inert></i> {{localize "bastionland.people.roll"}}</button>
			{{/unless}}{{/unless}}
		</div>
	</header>

	{{!-- A wilderness hex (p22): the Nature page's tables for one, laid out as the book prints them. The die
	      rolls every table, a table's own die both its columns, a heading its column, and a click on an entry
	      takes it by hand. Nothing is kept in the hex until Save. --}}
	{{#with wild}}
	{{#if missing}}
	<p class="bastionland-empty">{{localize "bastionland.spark.pageMissing"}}</p>
	{{else}}
	<section class="bastionland-wilderness-hex">
		<div class="bastionland-wilderness-hex__tables">
			{{#each tables}}
			<div class="bastionland-spark__table">
				<header class="bastionland-spark__table-header">
					<h2 class="bastionland-heading bastionland-heading--small">{{name}}</h2>
					<button type="button" class="bastionland-icon" data-action="rollWild" data-table="{{index}}" data-tooltip="{{rollLabel}}" aria-label="{{rollLabel}}">
						<i class="fa-solid fa-dice" inert></i>
					</button>
				</header>
				<table data-wild-table="{{index}}">
					<thead>
						<tr>
							<th scope="col"></th>
							{{#each columns}}
							<th scope="col"><button type="button" class="bastionland-knight-table__pick" data-action="rollWild" data-table="{{../index}}" data-column="{{index}}" data-tooltip="{{tooltip}}">{{label}}</button></th>
							{{/each}}
						</tr>
					</thead>
					<tbody>
						{{#each rows}}
						<tr>
							<th scope="row">{{number}}</th>
							{{#each entries}}
							<td data-column="{{column}}"{{#if rolled}} class="is-rolled"{{/if}}><button type="button" class="bastionland-knight-table__pick" data-action="pickRow" data-table="{{../../index}}" data-column="{{column}}" data-row="{{row}}" data-tooltip="{{localize 'bastionland.hexLore.wildHex.pick'}}">{{text}}</button></td>
							{{/each}}
						</tr>
						{{/each}}
					</tbody>
				</table>
			</div>
			{{/each}}
		</div>
		<nav class="bastionland-toolbar">
			<button type="button" data-action="rollWild"><i class="fa-solid fa-dice" inert></i> {{localize "bastionland.hexLore.wildHex.rollAll"}}</button>
			<button type="button" data-action="keepWild" data-keep-wild {{#if nothingTaken}}data-nothing-taken{{/if}} {{disabled save.disabled}}><i class="fa-solid fa-feather" inert></i> <span data-keep-label>{{save.label}}</span></button>
		</nav>
	</section>
	{{/if}}
	{{/with}}

	{{#if empty}}
	<p class="bastionland-empty">{{localize "bastionland.spark.pageMissing"}}</p>
	{{/if}}

	{{#unless wild}}
	<ul class="bastionland-spark__grid">
		{{#each tables}}
		<li class="bastionland-spark__table">
			<header class="bastionland-spark__table-header">
				<h2 class="bastionland-heading bastionland-heading--small">{{name}}</h2>
				<button type="button" class="bastionland-icon" data-action="roll" data-table="{{index}}" data-tooltip="{{rollLabel}}" aria-label="{{rollLabel}}">
					<i class="fa-solid fa-dice" inert></i>
				</button>
			</header>
			<table data-table="{{index}}">
				<thead>
					<tr>
						<th scope="col"></th>
						{{#each columns}}
						<th scope="col">{{this}}</th>
						{{/each}}
					</tr>
				</thead>
				<tbody>
					{{#each rows}}
					<tr>
						<th scope="row">{{number}}</th>
						{{#each entries}}
						<td data-column="{{@index}}"{{#if rolled}} class="is-rolled"{{/if}}>{{entry}}</td>
						{{/each}}
					</tr>
					{{/each}}
				</tbody>
			</table>
		</li>
		{{/each}}
	</ul>
	{{/unless}}
</div>
