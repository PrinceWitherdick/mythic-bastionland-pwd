<div class="bastionland-page bastionland-spark">
	{{#if notice}}
	<p class="bastionland-chooser__notice">{{notice}}</p>
	{{/if}}

	<header class="bastionland-spark__header">
		<ul class="bastionland-choices bastionland-choices--inline">
			{{#each pages}}
			<li>
				<button type="button" class="bastionland-choice{{#if active}} is-active{{/if}}" data-action="showPage" data-page="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
			</li>
			{{/each}}
		</ul>
		<p class="bastionland-hint">{{localize "bastionland.spark.hint"}}{{#if reference}} ({{reference}}){{/if}}</p>
	</header>

	{{#if empty}}
	<p class="bastionland-empty">{{localize "bastionland.spark.pageMissing"}}</p>
	{{/if}}

	<ul class="bastionland-spark__grid">
		{{#each tables}}
		<li class="bastionland-spark__table">
			<header class="bastionland-spark__table-header">
				<h2 class="bastionland-heading bastionland-heading--small">{{name}}</h2>
				<button type="button" class="bastionland-icon" data-action="roll" data-table="{{index}}" data-tooltip="{{rollLabel}}" aria-label="{{rollLabel}}">
					<i class="fa-solid fa-dice" inert></i>
				</button>
			</header>
			<table>
				<thead>
					<tr>
						<th scope="col"></th>
						{{#each columns}}
						<th scope="col">{{this}}</th>
						{{/each}}
					</tr>
				</thead>
				<tbody>
					{{#each rows}}
					<tr>
						<th scope="row">{{number}}</th>
						{{#each entries}}
						<td{{#if rolled}} class="is-rolled"{{/if}}>{{entry}}</td>
						{{/each}}
					</tr>
					{{/each}}
				</tbody>
			</table>
		</li>
		{{/each}}
	</ul>
</div>
