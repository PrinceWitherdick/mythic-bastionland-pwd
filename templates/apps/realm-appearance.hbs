<div class="bastionland-page bastionland-realm-appearance">
	<p class="bastionland-realm-appearance__target"><i class="fa-solid fa-map" inert></i> <strong>{{target}}</strong></p>
	<p class="hint">{{localize "bastionland.realm.look.intro"}}</p>

	<section class="bastionland-realm-appearance__section">
		<h3>{{localize "bastionland.realm.look.skin"}}</h3>
		<div class="bastionland-realm-appearance__skins">
			{{#each skins}}
			<button type="button" class="bastionland-realm-appearance__skin {{#if active}}is-active{{/if}}" data-action="pickSkin" data-skin="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
				<span class="bastionland-realm-appearance__samples" inert>
					{{#each samples}}<img src="{{this}}" alt="">{{/each}}
				</span>
				<strong>{{label}}</strong>
				<span class="hint">{{hint}}</span>
			</button>
			{{/each}}
		</div>
	</section>

	<section class="bastionland-realm-appearance__section">
		<h3>{{localize "bastionland.realm.look.palette"}}</h3>
		<div class="bastionland-realm-appearance__palettes">
			{{#each palettes}}
			<button type="button" class="bastionland-realm-appearance__palette {{#if active}}is-active{{/if}}" data-action="pickPalette" data-palette="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
				<span class="bastionland-realm-appearance__swatches" inert>
					{{#each swatches}}<span style="background: {{this}}"></span>{{/each}}
				</span>
				<span>{{label}}</span>
			</button>
			{{/each}}
		</div>
	</section>

	<section class="bastionland-realm-appearance__section">
		<h3>{{localize "bastionland.realm.look.pictures"}}</h3>
		<p class="hint">{{localize "bastionland.realm.look.ownIntro"}}</p>
		<div class="bastionland-realm-appearance__buttons">
			<input type="file" accept="image/*" multiple hidden>
			<button type="button" data-action="upload" {{#unless canUpload}}disabled{{/unless}}>
				<i class="fa-solid fa-file-arrow-up" inert></i> {{localize "bastionland.realm.look.upload"}}
			</button>
			<button type="button" data-action="chooseFolder" {{#unless canBrowse}}disabled{{/unless}}>
				<i class="fa-solid fa-folder-open" inert></i> {{localize "bastionland.realm.look.chooseFolder"}}
			</button>
			{{#if custom.folder}}
			<button type="button" data-action="rescan" {{#unless canBrowse}}disabled{{/unless}}>
				<i class="fa-solid fa-rotate" inert></i> {{localize "bastionland.realm.look.rescan"}}
			</button>
			{{/if}}
			{{#if custom.any}}
			<button type="button" data-action="clearCustom">
				<i class="fa-solid fa-xmark" inert></i> {{localize "bastionland.realm.look.clear"}}
			</button>
			{{/if}}
		</div>
		{{#if custom.folder}}
		<p><strong>{{custom.count}}</strong> <code>{{custom.folder}}</code></p>
		{{/if}}
		<div class="form-group">
			<label for="{{partId}}-fit">{{localize "bastionland.realm.look.terrainFit"}}</label>
			<div class="form-fields">
				<select id="{{partId}}-fit" name="terrainFit">
					{{#each custom.fits}}
					<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
					{{/each}}
				</select>
			</div>
		</div>
		<details class="bastionland-realm-appearance__names">
			<summary>{{localize "bastionland.realm.look.namesSummary"}}</summary>
			<p class="hint">{{localize "bastionland.realm.look.namesHint" dir=custom.dir}}</p>
			<ul>
				{{#each names}}<li class="{{#if found}}is-found{{/if}}"><code>{{name}}</code></li>{{/each}}
			</ul>
		</details>
	</section>

	<section class="bastionland-realm-appearance__section">
		<h3>{{localize "bastionland.realm.look.preview"}}</h3>
		<div class="bastionland-realm-appearance__preview" style="background: {{paper}}">
			{{#each groups}}
			<div class="bastionland-realm-appearance__group {{#if hexes}}is-hexes{{/if}}">
				{{#each pictures}}
				<figure>
					<img src="{{src}}" alt="{{label}}" data-name="{{label}}">
					{{#if own}}<figcaption class="is-own">{{localize "bastionland.realm.look.tags.own"}}</figcaption>{{/if}}
				</figure>
				{{/each}}
			</div>
			{{/each}}
		</div>
	</section>

	<footer class="bastionland-realm-appearance__buttons">
		<button type="button" data-action="reset">
			<i class="fa-solid fa-arrow-rotate-left" inert></i> {{localize "bastionland.realm.look.reset"}}
		</button>
		<button type="button" data-action="apply" {{#unless changed}}disabled{{/unless}}>
			<i class="fa-solid fa-paintbrush" inert></i> {{localize "bastionland.realm.look.apply"}}
		</button>
	</footer>
</div>
