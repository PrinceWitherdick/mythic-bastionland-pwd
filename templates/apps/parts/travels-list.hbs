{{!-- The Company's places on one Realm: as a list, as a chart, and as the journey's log. Shared by the Places window and the Knight sheet. --}}
{{#*inline "travels-row"}}
<li class="bastionland-travels__row{{#if selected}} is-selected{{/if}}" data-search="{{search}}" data-tags="{{tags}}">
	<button type="button" class="bastionland-travels__open" data-action="pickTravelsHex" data-hex="{{hex}}"{{#if selected}} aria-current="true"{{/if}}>
		{{#if name}}
		<span class="bastionland-travels__title">{{name}}</span>
		<span class="bastionland-travels__line bastionland-travels__coords">{{coords}}</span>
		{{else}}
		<span class="bastionland-travels__title">{{title}}</span>
		{{/if}}
		{{#if terrain}}<span class="bastionland-travels__line">{{terrain}}{{#if features}} · {{features}}{{/if}}</span>
		{{else if features}}<span class="bastionland-travels__line">{{features}}</span>{{/if}}
		<span class="bastionland-travels__line bastionland-travels__visits">{{visits}}</span>
	</button>
	<span class="bastionland-travels__chips">
		{{#if here}}<span class="bastionland-travels__chip bastionland-pill bastionland-travels__chip--here"><i class="fa-solid fa-flag" inert></i> {{localize "bastionland.travels.here"}}</span>{{/if}}
		{{#if told}}<span class="bastionland-travels__chip bastionland-pill"><i class="fa-solid fa-comment" inert></i> {{localize "bastionland.travels.chips.told"}}</span>{{/if}}
		{{#if noted}}<span class="bastionland-travels__chip bastionland-pill"><i class="fa-solid fa-pen-nib" inert></i> {{localize "bastionland.travels.chips.note"}}</span>{{/if}}
	</span>
	{{#if onMap}}
	<button type="button" class="bastionland-icon" data-action="showTravelsHex" data-hex="{{hex}}" data-tooltip="{{localize 'bastionland.travels.showOnMap'}}" aria-label="{{localize 'bastionland.travels.showOnMap'}}"><i class="fa-solid fa-location-crosshairs" inert></i></button>
	{{/if}}
</li>
{{/inline}}
{{#*inline "travels-section"}}
{{#if rows.length}}
<section class="bastionland-travels__section" data-search-section>
	<h3 class="bastionland-heading">{{heading}}</h3>
	{{#if hint}}<p class="bastionland-hint">{{hint}}</p>{{/if}}
	<ul class="bastionland-travels__list">
		{{#each rows}}{{> travels-row}}{{/each}}
	</ul>
</section>
{{/if}}
{{/inline}}
<div class="bastionland-travels" data-scene-id="{{sceneId}}">
	{{#if asPlayers}}<p class="bastionland-travels__banner">{{localize "bastionland.travels.asPlayers"}}</p>{{/if}}
	{{#if noRealm}}
	<p class="bastionland-hint">{{localize "bastionland.travels.noRealm"}}</p>
	{{else}}
	<div class="bastionland-travels__bar">
		{{#if chooseRealm}}
		<select class="bastionland-travels__realm" aria-label="{{localize 'bastionland.travels.realm'}}">
			{{#each realms}}
			<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
			{{/each}}
		</select>
		{{/if}}
		<input type="search" class="bastionland-travels__search" placeholder="{{localize 'bastionland.travels.search'}}" aria-label="{{localize 'bastionland.travels.search'}}">
	</div>

	<div class="bastionland-travels__views" role="group" aria-label="{{localize 'bastionland.travels.views.label'}}">
		{{#each views}}
		<button type="button" class="bastionland-travels__view-tab" data-travels-view="{{key}}" aria-pressed="{{#if shown}}true{{else}}false{{/if}}">{{label}}</button>
		{{/each}}
		<span class="bastionland-travels__summary">{{summary}}</span>
	</div>

	{{#if none}}
	<p class="bastionland-hint">{{localize "bastionland.travels.none"}}</p>
	{{else}}
	<div class="bastionland-travels__filters" role="group" aria-label="{{localize 'bastionland.travels.filters.label'}}">
		{{#each filters}}
		<button type="button" class="bastionland-travels__filter bastionland-pill" data-travels-filter="{{key}}" aria-pressed="{{#if pressed}}true{{else}}false{{/if}}">{{label}}</button>
		{{/each}}
	</div>
	<p class="bastionland-hint bastionland-travels__no-match" hidden>{{localize "bastionland.travels.noMatch"}}</p>

	<section class="bastionland-travels__view" data-view="places" {{#unless viewShown.places}}hidden{{/unless}}>
		<label class="bastionland-travels__sort">
			<span>{{localize "bastionland.travels.sort.label"}}</span>
			<select data-travels-sort>
				{{#each sorts}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
			</select>
		</label>
		{{> travels-section rows=ofNote heading=(localize "bastionland.travels.sections.ofNote") hint=(localize "bastionland.travels.sections.ofNoteHint")}}
		{{> travels-section rows=wilderness heading=(localize "bastionland.travels.sections.wilderness") hint=""}}
		{{> travels-section rows=heardOf heading=(localize "bastionland.travels.sections.heardOf") hint=(localize "bastionland.travels.sections.heardOfHint")}}
	</section>

	<section class="bastionland-travels__view" data-view="chart" {{#unless viewShown.chart}}hidden{{/unless}}>
		<div class="bastionland-travels-chart">{{{chart}}}</div>
		<div class="bastionland-travels-chart__foot">
			<label class="bastionland-travels-chart__route-toggle">
				<input type="checkbox" data-travels-route {{checked route}}>
				<span>{{localize "bastionland.travels.chart.route"}}</span>
			</label>
			<ul class="bastionland-travels-chart__legend" aria-label="{{localize 'bastionland.travels.chart.legend'}}">
				{{#each legend}}<li>{{{glyph}}}<span>{{label}}</span></li>{{/each}}
			</ul>
		</div>
	</section>

	<section class="bastionland-travels__view" data-view="journey" {{#unless viewShown.journey}}hidden{{/unless}}>
		{{#if journeyNone}}
		<p class="bastionland-hint">{{localize "bastionland.travels.journey.none"}}</p>
		{{else}}
		{{#each journey}}
		<section class="bastionland-travels-journey__season" data-search-section>
			<h3 class="bastionland-heading">{{heading}}</h3>
			{{#each days}}
			<ol class="bastionland-travels-journey__day" data-search-section>
				{{#each entries}}
				<li class="bastionland-travels-journey__entry bastionland-travels-journey__entry--{{kind}}" data-search="{{search}}" data-tags="{{tags}}">
					<span class="bastionland-travels-journey__phase">{{phase}}</span>
					<button type="button" class="bastionland-travels-journey__open" data-action="pickTravelsHex" data-hex="{{hex}}">
						<i class="{{icon}}" inert></i>
						<span class="bastionland-travels-journey__said">{{said}}</span>
						{{#if about}}<span class="bastionland-travels__line">{{about}}</span>{{/if}}
						{{#if note}}<span class="bastionland-travels-journey__note">{{note}}</span>{{/if}}
					</button>
				</li>
				{{/each}}
			</ol>
			{{/each}}
		</section>
		{{/each}}
		{{/if}}
	</section>
	{{/if}}
	{{/if}}
</div>
