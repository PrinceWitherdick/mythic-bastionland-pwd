{{!-- What a Timeline shows when the reader's Filter hides everything on it: a way to show it all again. --}}
<div class="bastionland-timeline__invite">
	<p class="bastionland-empty">{{localize "bastionland.timeline.allHidden"}}</p>
	<button type="button" class="bastionland-button" data-action="timeline" data-timeline="showAll" data-timeline-focus="show-all-invite">{{localize "bastionland.timeline.filter.showAll"}}</button>
</div>
