{{!-- One hex as the Company knows it, beside the Places window's list. Only the gm part at the foot, drawn for GMs alone, comes from what the GM keeps. --}}
<aside class="bastionland-travels-detail bastionland-hex-lore bastionland-travels-hex" aria-live="polite">
	{{#if empty}}
	<p class="bastionland-hint bastionland-travels-detail__empty">{{localize "bastionland.travels.detail.empty"}}</p>
	{{else}}
	<div class="bastionland-travels-hex__head">
		{{#with heading}}{{> "bastionland.hex-heading"}}{{/with}}
		{{#if openable}}{{#if here}}<span class="bastionland-hex-lore__feature bastionland-pill bastionland-travels__here"><i class="fa-solid fa-flag" inert></i> {{localize "bastionland.travels.here"}}</span>{{/if}}{{/if}}
	</div>

	{{#if openable}}
	<div class="bastionland-hex-lore__here">
		{{#if terrain}}<span class="bastionland-hex-lore__terrain bastionland-pill bastionland-pill--small-caps">{{terrain}}</span>{{/if}}
		{{#each features}}
		<span class="bastionland-hex-lore__feature bastionland-pill">{{this}}</span>
		{{/each}}
	</div>

	<div class="bastionland-hex-lore__row bastionland-travels-hex__visits">
		<span class="bastionland-hex-lore__hint">{{visits}}</span>
		{{#if onMap}}
		<button type="button" data-action="showTravelsHex" data-hex="{{hex}}"><i class="fa-solid fa-location-crosshairs" inert></i> {{localize "bastionland.travels.showOnMap"}}</button>
		{{/if}}
	</div>

	{{#if sighted}}<p class="bastionland-travels-hex__sighted"><i class="fa-solid fa-circle-question" inert></i> {{sighted}}</p>{{/if}}
	{{#each met}}<p class="bastionland-travels-hex__sighted"><i class="fa-solid fa-road-barrier" inert></i> {{this}}</p>{{/each}}

	<h3 class="bastionland-heading">{{localize "bastionland.travels.told.heading"}}</h3>
	<ul class="bastionland-hex-lore__rolls bastionland-travels-hex__told">
		{{#each told}}
		<li class="bastionland-hex-lore__roll">
			<div class="bastionland-hex-lore__prompt">
				<span class="bastionland-travels-hex__note">{{note}}</span>
				{{#if when}}<span class="bastionland-hex-lore__source">{{when}}</span>{{/if}}
			</div>
		</li>
		{{else}}
		<li class="bastionland-hint">{{localize "bastionland.travels.told.none"}}</li>
		{{/each}}
	</ul>

	<div class="form-group bastionland-hex-lore__note bastionland-travels-hex__party">
		<label for="{{@root.partId}}-party">{{localize "bastionland.travels.party.heading"}}</label>
		<div class="form-fields">
			<textarea id="{{@root.partId}}-party" name="party" data-hex="{{hex}}" rows="4" maxlength="2000" placeholder="{{localize "bastionland.travels.party.placeholder"}}" {{#unless canWrite}}readonly{{/unless}}>{{party}}</textarea>
		</div>
		{{#if partyBy}}<p class="bastionland-hint">{{partyBy}}</p>{{/if}}
		{{#if noGM}}<p class="bastionland-hint">{{localize "bastionland.travels.party.offline"}}</p>{{/if}}
	</div>

	{{#with gm}}
	<section class="bastionland-travels-hex__gm">
		<div class="bastionland-hex-lore__row">
			<h3 class="bastionland-heading">{{localize "bastionland.travels.gm.heading"}}</h3>
			<button type="button" data-action="openHexLore" data-hex="{{../hex}}"><i class="fa-solid fa-feather" inert></i> {{localize "bastionland.hexLore.open"}}</button>
		</div>
		<p class="bastionland-hint">{{localize "bastionland.travels.gm.hint"}}</p>
		{{#if features.length}}
		<div class="bastionland-hex-lore__here">
			{{#each features}}
			<span class="bastionland-hex-lore__feature bastionland-pill">{{this}}</span>
			{{/each}}
		</div>
		{{/if}}
		<ul class="bastionland-hex-lore__rolls">
			{{#each sparks}}
			<li class="bastionland-hex-lore__roll">
				{{> "bastionland.hex-spark"}}
			</li>
			{{else}}
			<li class="bastionland-hex-lore__hint">{{localize "bastionland.hexLore.noRolls"}}</li>
			{{/each}}
		</ul>
		{{#unless sparks.length}}
		<button type="button" class="bastionland-travels-hex__fill" data-action="rollWildHex" data-hex="{{../hex}}" data-tooltip="{{localize "bastionland.travels.gm.fillHint"}}"><i class="fa-solid fa-wand-sparkles" inert></i> {{localize "bastionland.hexLore.rollSet"}}</button>
		{{/unless}}
		{{#if note}}
		<h4 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.hexLore.note"}}</h4>
		<p class="bastionland-travels-hex__gm-note">{{note}}</p>
		{{/if}}
	</section>
	{{/with}}
	{{else}}
	<p class="bastionland-hex-lore__hint">{{localize "bastionland.travels.notKnown"}}</p>
	{{/if}}
	{{/if}}
</aside>
