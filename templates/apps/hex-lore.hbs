<div class="bastionland-page bastionland-hex-lore">
	{{#if missing}}
	<p class="bastionland-hex-lore__hint">{{localize "bastionland.realm.panel.missing"}}</p>
	{{else}}
	{{#with heading}}{{> "bastionland.hex-heading"}}{{/with}}
	<p class="bastionland-hex-lore__hint">{{localize "bastionland.hexLore.hint"}}</p>

	{{!-- The hex on the left, the rolls for it on the right: side by side when the window is wide, one stack when narrow. --}}
	<div class="bastionland-hex-lore__columns bastionland-columns">
		<div class="bastionland-hex-lore__column">
			<div class="bastionland-hex-lore__here">
				{{#if terrain}}<span class="bastionland-hex-lore__terrain bastionland-pill bastionland-pill--small-caps">{{terrain}}</span>{{/if}}
				{{#each features}}
				<span class="bastionland-hex-lore__feature bastionland-pill">{{this}}</span>
				{{/each}}
			</div>

			{{#if landmark}}
			<div class="form-group bastionland-hex-lore__landmark">
				<label for="{{partId}}-landmark">{{landmark.type}}</label>
				<div class="form-fields">
					<input id="{{partId}}-landmark" type="text" name="landmarkName" value="{{landmark.name}}" placeholder="{{localize "bastionland.hexLore.landmark.placeholder"}}">
					<button type="button" class="bastionland-icon" data-action="rerollLandmark" data-tooltip="{{localize "bastionland.hexLore.landmark.rerollHint"}}" aria-label="{{localize "bastionland.hexLore.landmark.reroll"}}"><i class="fa-solid fa-dice" inert></i></button>
				</div>
			</div>
			{{#if landmark.from}}<p class="bastionland-hex-lore__hint">{{landmark.from}}</p>{{/if}}
			{{/if}}

			{{#with edit}}{{> "bastionland.hex-edit"}}{{/with}}

			<div class="bastionland-hex-lore__row bastionland-hex-lore__visits">
				<span class="bastionland-hex-lore__hint">{{visits}}</span>
				{{#unless visited}}
				<button type="button" data-action="markVisited"><i class="fa-solid fa-shoe-prints" inert></i> {{localize "bastionland.gmToolkit.visits.mark"}}</button>
				{{/unless}}
			</div>

			{{!-- Forget what's kept here: the GM's fold, built by hexForgetContext in module/apps/hex-forget.js. --}}
			{{#with forget}}
			<details class="bastionland-hex-edit bastionland-hex-forget" data-hex-forget {{#if open}}open{{/if}}>
				<summary class="bastionland-hex-edit__summary">{{localize "bastionland.gmToolkit.visits.fold"}}</summary>
				<div class="bastionland-hex-edit__body">
					<p class="bastionland-hint">{{localize "bastionland.gmToolkit.visits.foldHint"}}</p>

					<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.gmToolkit.visits.visitsHeading"}}</h3>
					<ul class="bastionland-hex-lore__rolls bastionland-hex-forget__list">
						{{#each visits}}
						<li class="bastionland-hex-lore__roll">
							<div class="bastionland-hex-lore__prompt">
								<strong>{{label}}</strong>
								<span class="bastionland-hex-lore__source">{{when}}</span>
							</div>
							<button type="button" data-action="forgetVisit" data-order="{{order}}" aria-label="{{localize 'bastionland.gmToolkit.visits.forgetOne'}}" data-tooltip="{{localize 'bastionland.gmToolkit.visits.forgetOne'}}"><i class="fa-solid fa-xmark" inert></i></button>
						</li>
						{{else}}
						<li class="bastionland-hint">{{localize "bastionland.hexLore.notVisited"}}</li>
						{{/each}}
					</ul>

					<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.gmToolkit.visits.toldHeading"}}</h3>
					<ul class="bastionland-hex-lore__rolls bastionland-hex-forget__list">
						{{#each told}}
						<li class="bastionland-hex-lore__roll">
							<div class="bastionland-hex-lore__prompt">
								<span class="bastionland-hex-forget__note">{{note}}</span>
								{{#if when}}<span class="bastionland-hex-lore__source">{{when}}</span>{{/if}}
							</div>
							<button type="button" data-action="forgetTold" data-told="{{id}}" aria-label="{{localize 'bastionland.gmToolkit.visits.forgetTold'}}" data-tooltip="{{localize 'bastionland.gmToolkit.visits.forgetTold'}}"><i class="fa-solid fa-xmark" inert></i></button>
						</li>
						{{else}}
						<li class="bastionland-hint">{{localize "bastionland.gmToolkit.visits.noTold"}}</li>
						{{/each}}
					</ul>

					<h3 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.travels.party.heading"}}</h3>
					<ul class="bastionland-hex-lore__rolls bastionland-hex-forget__list">
						{{#if party}}
						<li class="bastionland-hex-lore__roll">
							<div class="bastionland-hex-lore__prompt">
								<span class="bastionland-hex-forget__note">{{party.text}}</span>
								<span class="bastionland-hex-lore__source">{{party.by}}</span>
							</div>
							<button type="button" data-action="forgetParty" aria-label="{{localize 'bastionland.gmToolkit.visits.forgetParty'}}" data-tooltip="{{localize 'bastionland.gmToolkit.visits.forgetParty'}}"><i class="fa-solid fa-xmark" inert></i></button>
						</li>
						{{else}}
						<li class="bastionland-hint">{{localize "bastionland.gmToolkit.visits.noParty"}}</li>
						{{/if}}
					</ul>

					<div class="bastionland-hex-lore__grid">
						<button type="button" data-action="forgetVisits" {{disabled noVisits}}><i class="fa-solid fa-route" inert></i> {{localize "bastionland.gmToolkit.visits.forgetAll"}}</button>
						<button type="button" data-action="forgetAll" {{disabled nothing}}><i class="fa-solid fa-eraser" inert></i> {{localize "bastionland.gmToolkit.visits.forgetEverything"}}</button>
					</div>
				</div>
			</details>
			{{/with}}

			<div class="form-group bastionland-hex-lore__note">
				<label for="{{partId}}-note">{{localize "bastionland.hexLore.note"}}</label>
				<div class="form-fields">
					<textarea id="{{partId}}-note" name="note" rows="5" placeholder="{{localize "bastionland.hexLore.notePlaceholder"}}">{{note}}</textarea>
				</div>
			</div>
			{{#with party}}{{> "bastionland.party-note"}}{{/with}}
			{{#if told}}<p class="bastionland-hint">{{told}}</p>{{/if}}
		</div>

		<div class="bastionland-hex-lore__column">
			<fieldset class="bastionland-hex-lore__spark">
				<legend>{{localize "bastionland.hexLore.spark"}}</legend>
				{{#if notice}}
				<p class="bastionland-hex-lore__hint">{{notice}}</p>
				{{else}}
				<div class="bastionland-hex-lore__grid">
					<button type="button" data-action="rollSet"><i class="fa-solid fa-wand-sparkles" inert></i> {{localize "bastionland.hexLore.rollSet"}}</button>
					<button type="button" data-action="rollPerson" data-tooltip="{{localize "bastionland.people.rollHint"}}"><i class="fa-solid fa-user" inert></i> {{localize "bastionland.people.roll"}}</button>
					{{#if holding}}
					<button type="button" class="is-wide" data-action="rollHolding" data-tooltip="{{localize "bastionland.people.holding.rollHint"}}"><i class="fa-solid fa-chess-rook" inert></i> {{localize "bastionland.people.holding.roll"}}</button>
					{{/if}}
					<button type="button" data-action="browse"><i class="fa-solid fa-table-list" inert></i> {{localize "bastionland.spark.title"}}</button>
					<button type="button" data-action="flipBook" data-tooltip="{{localize "bastionland.bookFlip.openHint"}}"><i class="fa-solid fa-book-open" inert></i> {{localize "bastionland.bookFlip.open"}}</button>
				</div>
				{{/if}}
			</fieldset>

			<ul class="bastionland-hex-lore__rolls">
				{{#each sparks}}
				<li class="bastionland-hex-lore__roll">
					{{> "bastionland.hex-spark" renameable=@root.renameable}}
					<button type="button" data-action="forget" data-spark="{{id}}" aria-label="{{localize "bastionland.hexLore.forget"}}"><i class="fa-solid fa-xmark" inert></i></button>
				</li>
				{{else}}
				<li class="bastionland-hex-lore__hint">{{localize "bastionland.hexLore.noRolls"}}</li>
				{{/each}}
			</ul>

			<fieldset class="bastionland-hex-lore__explore">
				<legend>{{localize "bastionland.hexLore.explore"}}</legend>
				<p class="bastionland-hex-lore__hint">{{localize "bastionland.hexLore.exploreHint"}}</p>
				<div class="bastionland-hex-lore__grid">
					<button type="button" data-action="wilderness"><i class="fa-solid fa-tree" inert></i> {{localize "bastionland.realm.panel.wildernessHere"}}</button>
					<button type="button" data-action="act" data-act="folklore"><i class="fa-solid fa-comments" inert></i> {{localize "bastionland.travelRules.sections.folklore.act"}}</button>
					<button type="button" data-action="act" data-act="search"><i class="fa-solid fa-magnifying-glass" inert></i> {{localize "bastionland.travelRules.sections.searching.act"}}</button>
					<button type="button" data-action="act" data-act="vantage"><i class="fa-solid fa-binoculars" inert></i> {{localize "bastionland.travelRules.sections.vision.act"}}</button>
					{{#if holding}}
					<button type="button" class="is-wide" data-action="mood" data-tooltip="{{localize "bastionland.refereeRolls.tables.mood.hint"}}"><i class="fa-solid fa-masks-theater" inert></i> {{localize "bastionland.refereeRolls.tables.mood.name"}}</button>
					{{/if}}
				</div>
			</fieldset>

			<div class="bastionland-hex-lore__grid bastionland-hex-lore__footer">
				<button type="button" data-action="tell"><i class="fa-solid fa-comment" inert></i> {{localize "bastionland.hexLore.tell"}}</button>
				{{#if journal}}
				<button type="button" data-action="journal" data-tooltip="{{localize "bastionland.hexJournal.openHint"}}"><i class="fa-solid fa-book" inert></i> {{localize "bastionland.hexJournal.open"}}</button>
				{{/if}}
			</div>
		</div>
	</div>
	{{/if}}
</div>
