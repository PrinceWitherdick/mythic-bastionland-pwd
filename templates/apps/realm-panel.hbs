<div class="bastionland-page bastionland-realm-panel">
	{{#if missing}}
	<p class="bastionland-realm-panel__hint">{{localize "bastionland.realm.panel.missing"}}</p>
	{{else}}
	<p class="bastionland-realm-panel__hint">{{hint}}</p>

	<div class="bastionland-realm-panel__columns">
		<section class="bastionland-realm-panel__group">
			<h2 class="bastionland-realm-panel__heading">{{localize "bastionland.realm.panel.terrain"}}</h2>
			{{> "bastionland.realm-tally" terrainTally}}
			<div class="bastionland-realm-panel__palette">
				{{#each swatches.terrain}}{{> "bastionland.realm-swatch" this}}{{/each}}
				{{#each swatches.river}}{{> "bastionland.realm-swatch" this}}{{/each}}
			</div>
			{{#if river.active}}
			<p class="bastionland-realm-panel__river">{{river.length}}</p>
			<button type="button" data-action="clearRiver" {{disabled river.none}}><i class="fa-solid fa-trash" inert></i> {{river.clear}}</button>
			{{/if}}

			<h2 class="bastionland-realm-panel__heading">{{localize "bastionland.realm.panel.barriers"}}</h2>
			{{> "bastionland.realm-tally" barrierTally}}
			<div class="bastionland-realm-panel__palette">
				{{#each swatches.barrier}}{{> "bastionland.realm-swatch" this}}{{/each}}
			</div>
		</section>

		<section class="bastionland-realm-panel__group">
			<h2 class="bastionland-realm-panel__heading">{{localize "bastionland.realm.panel.holdings"}}</h2>
			{{> "bastionland.realm-tally" holdingTally}}
			<div class="bastionland-realm-panel__palette bastionland-realm-panel__palette--pairs">
				{{#each swatches.holding}}{{> "bastionland.realm-swatch" this}}{{/each}}
			</div>
			{{> "bastionland.realm-tally" seatTally}}

			<h2 class="bastionland-realm-panel__heading">{{localize "bastionland.realm.panel.landmarks"}}</h2>
			{{> "bastionland.realm-tally" landmarkTally}}
			<div class="bastionland-realm-panel__palette">
				{{#each swatches.landmark}}{{> "bastionland.realm-swatch" this}}{{/each}}
			</div>
		</section>
	</div>

	<!-- Last in the panel, so the palette above it never moves as it goes from greyed to live. -->
	<div class="bastionland-realm-panel__history">
		<button type="button" data-action="undo" {{disabled undoDisabled}}><i class="fa-solid fa-rotate-left" inert></i> {{localize "bastionland.realm.panel.undo"}}</button>
		<button type="button" data-action="redo" {{disabled redoDisabled}}><i class="fa-solid fa-rotate-right" inert></i> {{localize "bastionland.realm.panel.redo"}}</button>
	</div>
	{{/if}}
</div>
