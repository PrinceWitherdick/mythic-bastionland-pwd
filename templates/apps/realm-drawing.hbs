<div class="bastionland-travel-rules__sheet">
	<header class="bastionland-travel-rules__header">
		<h2 class="bastionland-travel-rules__title">{{title}}</h2>
		{{#if pageLink}}
		<button type="button" class="bastionland-travel-rules__page" data-action="openPage" data-page="{{pageNumber}}" data-tooltip="{{pageLink}}" aria-label="{{pageLink}}">{{page}}</button>
		{{else}}
		<span class="bastionland-travel-rules__page">{{page}}</span>
		{{/if}}
	</header>

	<div class="bastionland-travel-rules__body">
		<button type="button" class="bastionland-travel-rules__roll bastionland-realm-drawing__palette{{#if palette.active}} is-active{{/if}}" data-action="useTool" data-tool="{{palette.name}}" aria-pressed="{{#if palette.active}}true{{else}}false{{/if}}">
			<i class="{{palette.icon}}" inert></i> {{palette.label}}
		</button>
		{{#if intro}}
		<p class="bastionland-realm-drawing__intro">{{intro}}</p>
		{{/if}}

		{{#each groups}}
		<section class="bastionland-travel-rules__group" data-group="{{key}}">
			<h3 class="bastionland-travel-rules__group-heading"><span class="bastionland-travel-rules__group-name">{{heading}}</span></h3>

			{{#each sections}}
			<section class="bastionland-travel-rules__section" data-section="{{key}}">
				{{#each blocks}}
				{{#if bullets}}
				<ul class="bastionland-realm-drawing__bullets">
					{{#each bullets}}
					<li>{{this}}</li>
					{{/each}}
				</ul>
				{{else if lines}}
				<details class="bastionland-realm-drawing__fold" data-fold="{{../key}}">
					<summary>{{@root.more}}</summary>
					<dl class="bastionland-travel-rules__lines">
						{{#each lines}}
						<div><dt>{{label}}</dt> <dd>{{text}}</dd></div>
						{{/each}}
					</dl>
				</details>
				{{else}}
				<p>{{text}}</p>
				{{/if}}
				{{/each}}
				{{#if counts}}
				<ul class="bastionland-realm-drawing__tally">
					{{#each counts}}
					<li class="{{#if done}}is-done{{/if}}"><i class="fa-solid {{#if done}}fa-check{{else}}fa-circle-dot{{/if}}" inert></i> {{label}}</li>
					{{/each}}
				</ul>
				{{/if}}
				{{#if tool}}
				<button type="button" class="bastionland-travel-rules__roll{{#if tool.active}} is-active{{/if}}" data-action="useTool" data-tool="{{tool.name}}" aria-pressed="{{#if tool.active}}true{{else}}false{{/if}}"{{#if tool.hint}} data-tooltip="{{tool.hint}}"{{/if}}>
					<i class="{{tool.icon}}" inert></i> {{tool.label}}
				</button>
				{{/if}}
			</section>
			{{/each}}
		</section>
		{{/each}}
		<p class="bastionland-travel-rules__credit">{{credit}}</p>
	</div>
</div>
