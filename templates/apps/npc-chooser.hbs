<div class="bastionland-page bastionland-chooser">
	{{#if notice}}
	<p class="bastionland-chooser__notice">{{notice}}</p>
	{{/if}}

	<div class="bastionland-chooser__layout bastionland-chooser__layout--npc">
		<section class="bastionland-chooser__browse" aria-label="{{localize 'bastionland.npcChooser.title'}}">
			<ul class="bastionland-choices bastionland-choices--inline">
				{{#each sources}}
				<li>
					<button type="button" class="bastionland-choice{{#if active}} is-active{{/if}}" data-action="showSource" data-source="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
				</li>
				{{/each}}
			</ul>
			<ul class="bastionland-chooser__groups">
				{{#each groups}}
				<li>
					<button type="button" class="bastionland-chooser__group{{#if active}} is-active{{/if}}" data-action="showGroup" data-d6="{{d6}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{d6}}</button>
				</li>
				{{/each}}
			</ul>
			<ul class="bastionland-chooser__grid bastionland-chooser__grid--wide">
				{{#each cards}}
				<li>
					<button type="button" class="bastionland-chooser__card{{#if selected}} is-selected{{/if}}" data-action="pick" data-roll="{{roll}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
						<span class="bastionland-chooser__card-roll">{{d12}}</span>
						{{#if img}}
						<img class="bastionland-chooser__thumb bastionland-chooser__thumb--wide" src="{{img}}" alt="" loading="lazy" data-name="{{name}}">
						{{else}}
						<span class="bastionland-chooser__thumb bastionland-chooser__thumb--wide is-empty"><i class="fa-solid fa-book-open" inert></i></span>
						{{/if}}
						<span class="bastionland-chooser__card-name">{{name}}</span>
					</button>
				</li>
				{{/each}}
			</ul>
		</section>

		<section class="bastionland-chooser__detail bastionland-npc-chooser__detail">
			{{#with selected}}
			{{#if img}}
			<img class="bastionland-npc-chooser__art" src="{{img}}" alt="{{name}}">
			{{/if}}
			<div>
				<p class="bastionland-chooser__reference">{{reference}}</p>
				<h2 class="bastionland-chooser__name">{{name}}</h2>
			</div>

			{{#if omens.length}}
			<details class="bastionland-npc-chooser__omens">
				<summary class="bastionland-heading bastionland-heading--small">{{localize "bastionland.npcChooser.omens"}}</summary>
				<ol>
					{{#each omens}}
					<li>{{this}}</li>
					{{/each}}
				</ol>
			</details>
			{{/if}}

			{{#if castNote}}
			<p class="bastionland-hint">{{castNote}}</p>
			{{/if}}

			<ul class="bastionland-npc-chooser__people">
				{{#each people}}
				<li class="bastionland-npc-chooser__person">
					<h3 class="bastionland-npc-chooser__person-name">{{name}}</h3>
					{{#if statLine}}
					<p class="bastionland-npc-chooser__stats">{{statLine}}</p>
					{{/if}}
					{{#each lines}}
					<p>{{this}}</p>
					{{/each}}
					<button type="button" class="bastionland-button" data-action="create" data-index="{{index}}">
						<i class="fa-solid fa-user-plus" inert></i> {{@root.createLabel}}
					</button>
				</li>
				{{else}}
				<li class="bastionland-empty">{{localize "bastionland.npcChooser.noPeople"}}</li>
				{{/each}}
			</ul>
			{{else}}
			<p class="bastionland-empty">{{localize "bastionland.npcChooser.noSelection"}}</p>
			{{/with}}
		</section>
	</div>
</div>
