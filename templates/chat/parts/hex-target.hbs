{{!-- A hex a card names: pointing at it rings the hex on the map, and a click takes the clicker's map there. With heading, it is the card's title. --}}
<button type="button" class="bastionland-hex-target{{#if heading}} bastionland-hex-target--heading{{else}} bastionland-pill{{/if}}" data-hex-target="{{key}}" data-hex-scene="{{scene}}" data-tooltip="{{localize "bastionland.hexTarget.hint"}}"><i class="fa-solid fa-crosshairs" inert></i> {{label}}</button>
