{{!-- A hex a card names: pointing at it rings the hex on the map, and a click takes the map there. --}}
<button type="button" class="bastionland-hex-target bastionland-pill" data-hex-target="{{key}}" data-hex-scene="{{scene}}" data-tooltip="{{localize "bastionland.hexTarget.hint"}}"><i class="fa-solid fa-crosshairs" inert></i> {{label}}</button>
