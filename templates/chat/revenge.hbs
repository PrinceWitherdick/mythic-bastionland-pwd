{{!-- Whoever dealt a Humiliation is brought down, and the table says whether it's revenge (p9). --}}
<section class="bastionland-card bastionland-card--revenge">
	<header class="bastionland-card__header">
		<h3 class="bastionland-card__title"><i class="fa-solid fa-hand-fist" inert></i> {{localize "bastionland.revenge.title"}}</h3>
		<p class="bastionland-card__tagline">{{tagline}}</p>
	</header>
	<p class="bastionland-card__text">{{text}}</p>
	<div class="bastionland-card__actions">
		<button type="button" data-revenge-scar="{{uuid}}"><i class="fa-solid fa-hand-holding-medical" inert></i> {{localize "bastionland.revenge.settle"}}</button>
	</div>
</section>
