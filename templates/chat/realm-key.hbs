<section class="bastionland-card bastionland-card--realm-key">
	<header class="bastionland-card__header">
		<h3 class="bastionland-card__title">{{title}}</h3>
		<p class="bastionland-card__tagline">{{#if custom}}{{localize "bastionland.realm.key.taglineCustom" seed=seed}}{{else}}{{localize "bastionland.realm.key.tagline" seed=seed}}{{/if}}</p>
	</header>

	{{#if myths.length}}
	<h4 class="bastionland-card__heading">{{localize "bastionland.realm.key.myths"}}</h4>
	<ul class="bastionland-card__list">
		{{#each myths}}
		<li><strong>{{number}}</strong> {{name}} <span class="bastionland-card__hint">{{localize "bastionland.realm.key.page" page=page}}, {{> "bastionland.hex-target" where}}</span></li>
		{{/each}}
	</ul>
	{{/if}}

	{{#if holdings.length}}
	<h4 class="bastionland-card__heading">{{localize "bastionland.realm.key.holdings"}}</h4>
	<ul class="bastionland-card__list">
		{{#each holdings}}
		<li>{{name}}{{#if seat}} <em>{{localize "bastionland.realm.key.seat"}}</em>{{/if}} <span class="bastionland-card__hint">{{> "bastionland.hex-target" where}}</span></li>
		{{/each}}
	</ul>
	{{/if}}

	{{#if sanctums.length}}
	<h4 class="bastionland-card__heading">{{localize "bastionland.realm.key.sanctums"}}</h4>
	<ul class="bastionland-card__list">
		{{#each sanctums}}
		<li>{{name}} <span class="bastionland-card__hint">{{localize "bastionland.realm.key.page" page=page}}, {{> "bastionland.hex-target" where}}</span></li>
		{{/each}}
	</ul>
	{{/if}}

	<p class="bastionland-card__hint">{{localize "bastionland.realm.key.counts" landmarks=landmarks barriers=barriers}}</p>
</section>
