<section class="bastionland-card bastionland-card--attack{{#if settled}} is-settled{{/if}}">
	<header class="bastionland-card__header">
		<h3 class="bastionland-card__title">{{localize "bastionland.attack.title"}}</h3>
		{{#if targets}}
		<p class="bastionland-card__tagline">{{targets}}</p>
		{{/if}}
	</header>

	{{#if smite}}
	<p class="bastionland-card__tagline">{{smite.name}}: {{smite.tagline}}</p>
	{{> "bastionland.save-result" save=smite.save}}
	<p class="bastionland-card__outcome">{{smite.outcome}}</p>
	{{/if}}
	{{#if smiteMark}}
	<p class="bastionland-card__hint">{{smiteMark}}</p>
	{{/if}}

	{{!-- Others attacking the same target roll with the attacker, as one Attack (p8). --}}
	{{#each joined}}
	<p class="bastionland-card__tagline">{{line}}</p>
	{{#if smite}}
	{{> "bastionland.save-result" save=smite.save}}
	<p class="bastionland-card__outcome">{{smite.outcome}}</p>
	{{/if}}
	{{#if smiteMark}}
	<p class="bastionland-card__hint">{{smiteMark}}</p>
	{{/if}}
	{{#if leader}}
	<p class="bastionland-card__hint">{{leader}}</p>
	{{/if}}
	{{#each warnings}}
	<p class="bastionland-card__warning">{{this}}</p>
	{{/each}}
	{{/each}}

	<ol class="bastionland-dice">
		{{#each dice}}
		<li>
			<button type="button" class="bastionland-die{{#if isHighest}} is-highest{{/if}}{{#if isGambit}} is-gambit{{/if}}{{#if isStrong}} is-strong{{/if}}{{#if spent}} is-spent{{/if}}{{#if barred}} is-barred{{/if}}" data-attack-action="gambit" data-die="{{index}}" title="d{{faces}} {{label}}{{#if barred}}: {{barred}}{{/if}}"{{#if barred}} data-tooltip="{{barred}}"{{/if}} {{disabled locked}}>
				<span class="bastionland-die__face" data-faces="{{faces}}" style="--bastionland-die-mask: {{shape}}">
					<span class="bastionland-die__result">{{result}}</span>
				</span>
				<span class="bastionland-die__faces">d{{faces}}</span>
				<span class="bastionland-die__label">{{label}}</span>
			</button>
		</li>
		{{/each}}
	</ol>

	{{#if gambitPrompt}}
	<p class="bastionland-card__prompt">{{gambitPrompt}}{{#if strongPrompt}} {{strongPrompt}}{{/if}}</p>
	{{/if}}
	{{#if denyPrompt}}
	<p class="bastionland-card__prompt">{{denyPrompt}}</p>
	{{/if}}
	{{#if takeBack}}
	<p class="bastionland-card__hint">{{takeBack}}</p>
	{{/if}}
	{{#if gambitHelp}}
	<details class="bastionland-card__gambit-help">
		<summary>{{gambitHelp.label}}</summary>
		<ul>
			{{#each gambitHelp.lines}}
			<li>{{{this}}}</li>
			{{/each}}
		</ul>
		<p class="bastionland-card__hint">{{{gambitHelp.strong}}}</p>
		<p class="bastionland-card__hint">{{{gambitHelp.hint}}}</p>
	</details>
	{{/if}}

	{{#if gambits.length}}
	<ul class="bastionland-card__gambits">
		{{#each gambits}}
		<li class="bastionland-card__gambit{{#if ignored}} is-ignored{{/if}}">
			<span class="bastionland-card__gambit-effect">{{{effect}}}</span>
			<span class="bastionland-tag">{{source}}{{#if strong}} · {{strong}}{{/if}}</span>
			{{#if weapon}}<span class="bastionland-card__hint">{{weapon}}</span>{{/if}}
			{{#if bonus}}<span class="bastionland-card__hint">{{bonus}}</span>{{/if}}
			{{#if focus}}<span class="bastionland-card__gambit-save{{#if focus.passed}} is-pass{{else}} is-fail{{/if}}">{{focus.result}}</span>{{/if}}
			{{#if save.none}}<span class="bastionland-card__hint">{{save.none}}</span>{{/if}}
			{{#if save.result}}
			<span class="bastionland-card__gambit-save{{#if save.passed}} is-pass{{else}} is-fail{{/if}}">{{save.result}}</span>
			{{/if}}
			{{#if save.button}}
			<button type="button" data-attack-action="gambit-save" data-gambit="{{save.index}}"><i class="fa-solid fa-dice-d20" inert></i> {{save.button}}</button>
			{{/if}}
			{{#if greater.done}}
			<span class="bastionland-card__gambit-save is-fail">{{greater.done}}</span>
			{{else if greater.waiting}}
			<span class="bastionland-card__hint">{{greater.waiting}}</span>
			{{else if greater}}
			<button type="button" data-attack-action="greater" data-gambit="{{greater.index}}" data-tooltip="{{greater.hint}}"><i class="fa-solid fa-hand-fist" inert></i> {{greater.label}}</button>
			{{/if}}
		</li>
		{{/each}}
	</ul>
	{{/if}}

	{{!-- A joint Attack's Damage counts only the dice that can harm its target (p11). --}}
	{{#if unharmed}}
	<p class="bastionland-card__warning">{{unharmed}}</p>
	{{else}}
	<p class="bastionland-card__damage">
		<span>{{localize "bastionland.attack.damage"}}</span>
		<strong>{{damage}}</strong>
	</p>
	{{/if}}
	{{#if barredNote}}
	<p class="bastionland-card__hint">{{barredNote}}</p>
	{{/if}}
	{{#if breakdown}}
	<p class="bastionland-card__hint">{{breakdown}}</p>
	{{/if}}
	{{#unless settled}}
	<p class="bastionland-card__hint">{{localize "bastionland.attack.damageNote"}}</p>
	{{/unless}}

	{{#each setAside}}
	<p class="bastionland-card__warning">{{this}}</p>
	{{/each}}
	{{#if impaired}}
	<p class="bastionland-card__warning">{{impairedText}}</p>
	{{/if}}
	{{#if blast}}
	<p class="bastionland-card__hint"><strong>{{localize "bastionland.attack.blast"}}</strong>: {{localize "bastionland.attack.blastHint"}}</p>
	{{/if}}
	{{#if leader}}
	<p class="bastionland-card__hint">{{leader}}</p>
	{{/if}}
	{{#if ignoresArmour}}
	<p class="bastionland-card__hint"><strong>{{localize "bastionland.item.ignoresArmour"}}</strong>: {{localize "bastionland.item.ignoresArmourHint"}}</p>
	{{/if}}
	{{#each weaponNotes}}
	<p class="bastionland-card__hint">{{this}}</p>
	{{/each}}

	{{#if settled}}
	<p class="bastionland-card__outcome">{{appliedTo}}</p>
	{{else}}
	<div class="bastionland-card__actions">
		<button type="button" data-attack-action="deny"><i class="fa-solid fa-shield-halved"></i> {{localize "bastionland.feats.deny.name"}}</button>
		{{#if focusable}}
		<button type="button" data-attack-action="focus"><i class="fa-solid fa-eye"></i> {{localize "bastionland.feats.focus.name"}}</button>
		{{/if}}
		{{#if joinable}}
		<button type="button" data-attack-action="join" data-tooltip="{{localize 'bastionland.attack.joinHint'}}"><i class="fa-solid fa-user-plus"></i> {{localize "bastionland.attack.join"}}</button>
		{{/if}}
		{{#unless duel}}
		<button type="button" data-attack-action="apply"><i class="fa-solid fa-heart-crack"></i> {{localize "bastionland.attack.apply"}}</button>
		{{/unless}}
	</div>
	{{#if duel}}
	<p class="bastionland-card__hint">{{localize "bastionland.duel.heldForDuel"}}</p>
	{{/if}}
	{{/if}}
</section>
