{{!-- A `tone` (a Phase or a Season) paints the card in its colours. A card
with a `d6` reads as the Luck Roll's does: what the roll is under its name,
then the die and what it gave under the rule. --}}
<section class="bastionland-card bastionland-card--report{{#if tone}} bastionland-card--painted bastionland-card--{{tone}}{{/if}}">
	<header class="bastionland-card__header">
		<h3 class="bastionland-card__title">{{#if icon}}<i class="{{icon}}" inert></i> {{/if}}{{title}}</h3>
		{{#if description}}<p class="bastionland-card__hint">{{description}}</p>{{/if}}
		{{#unless d6}}<p class="bastionland-card__tagline">{{tagline}}</p>{{/unless}}
	</header>
	{{#if d6}}
	<p class="bastionland-card__outcome"><span class="bastionland-card__roll">{{d6}}</span> {{tagline}}</p>
	{{/if}}
	{{#if entries.length}}
	<ul class="bastionland-card__entries">
		{{#each entries}}
		<li>
			<strong>{{name}}</strong>{{#if pursuit}} · {{pursuit}}{{/if}}
			{{#each lines}}
			<p class="bastionland-card__text">{{this}}</p>
			{{/each}}
		</li>
		{{/each}}
	</ul>
	{{/if}}
	{{#if due.length}}
	<div class="bastionland-card__due">
		<p class="bastionland-card__due-title">{{localize "bastionland.time.due.title"}}</p>
		{{#each due}}
		<p class="bastionland-card__text">{{this}}</p>
		{{/each}}
	</div>
	{{/if}}
	{{#if hint}}
	<p class="bastionland-card__hint{{#if hintAside}} bastionland-card__hint--aside{{/if}}">{{hint}}</p>
	{{/if}}
</section>
