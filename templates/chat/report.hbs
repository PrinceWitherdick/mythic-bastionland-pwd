<section class="bastionland-card bastionland-card--report">
	<header class="bastionland-card__header">
		<h3 class="bastionland-card__title">{{title}}</h3>
		<p class="bastionland-card__tagline">{{#if d6}}<span class="bastionland-card__roll">{{d6}}</span> {{/if}}{{tagline}}</p>
	</header>
	{{#if entries.length}}
	<ul class="bastionland-card__entries">
		{{#each entries}}
		<li>
			<strong>{{name}}</strong>{{#if pursuit}} · {{pursuit}}{{/if}}
			{{#each lines}}
			<p class="bastionland-card__text">{{this}}</p>
			{{/each}}
		</li>
		{{/each}}
	</ul>
	{{/if}}
	{{#if hint}}
	<p class="bastionland-card__hint">{{hint}}</p>
	{{/if}}
</section>
