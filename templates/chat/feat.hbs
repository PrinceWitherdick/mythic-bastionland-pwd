<section class="bastionland-card">
	<header class="bastionland-card__header">
		<h3 class="bastionland-card__title">{{feat.name}}</h3>
		<p class="bastionland-card__tagline">{{feat.tagline}}</p>
	</header>
	<p class="bastionland-card__text">{{feat.use}}</p>
	{{> "bastionland.save-result" save=feat.save}}
	<p class="bastionland-card__outcome">{{feat.outcome}}</p>
</section>
