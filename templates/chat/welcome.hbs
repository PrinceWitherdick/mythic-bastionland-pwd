<section class="bastionland-card bastionland-card--welcome">
	<header class="bastionland-card__header">
		<h3 class="bastionland-card__title">{{title}}</h3>
	</header>
	<p class="bastionland-card__text">{{text}}</p>
	{{#if modules}}
	<ul class="bastionland-card__list bastionland-card__modules">
		{{#each modules}}
		<li><a href="{{url}}" target="_blank" rel="noopener">{{name}}</a> {{text}}</li>
		{{/each}}
	</ul>
	{{/if}}
	{{#each more}}
	<p class="bastionland-card__text">{{this}}</p>
	{{/each}}
	<div class="bastionland-card__actions">
		<button type="button" data-welcome-card="{{card}}"><i class="{{icon}}" inert></i> {{label}}</button>
	</div>
</section>
