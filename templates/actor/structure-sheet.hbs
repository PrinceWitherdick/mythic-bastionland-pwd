<div class="bastionland-page bastionland-page--structure">
	{{> "bastionland.npc-header"}}

	{{#if editable}}
	<nav class="bastionland-toolbar bastionland-toolbar--actions" aria-label="{{actor.name}}">
		{{#if canAttack}}
		<button type="button" data-action="attack"><i class="fa-solid fa-swords" inert></i> {{localize "bastionland.sheet.attack"}}</button>
		{{/if}}
		<button type="button" data-action="takeDamage"><i class="fa-solid fa-heart-crack" inert></i> {{localize "bastionland.sheet.takeDamage"}}</button>
		<button type="button" data-action="repair" data-tooltip="{{localize 'bastionland.structure.repairHint'}}"><i class="fa-solid fa-hammer" inert></i> {{localize "bastionland.structure.repair"}}</button>
		{{#if isShip}}
		<button type="button" data-action="collide" data-tooltip="{{localize 'bastionland.structure.collide.hint'}}"><i class="fa-solid fa-sailboat" inert></i> {{localize "bastionland.structure.collide.title"}}</button>
		{{/if}}
	</nav>
	{{/if}}

	<div class="bastionland-columns">
		<div class="bastionland-column">
			<section class="bastionland-scores">
				<div class="bastionland-score">
					<span class="bastionland-score__name bastionland-score__name--word" data-tooltip="{{localize 'bastionland.structure.guardHint'}}">{{localize "bastionland.guard.label"}}</span>
					<input class="bastionland-box" type="number" name="system.guard.value" value="{{system.guard.value}}" min="0" step="1" aria-label="{{localize 'bastionland.guard.label'}} {{localize 'bastionland.sheet.current'}}">
					<input class="bastionland-box bastionland-box--max" type="number" name="system.guard.max" value="{{system.guard.max}}" min="0" step="1" aria-label="{{localize 'bastionland.guard.label'}} {{localize 'bastionland.sheet.maximum'}}">
				</div>

				<div class="bastionland-score">
					<label class="bastionland-score__name bastionland-score__name--word" for="{{rootId}}-armour">{{localize "bastionland.sheet.armour"}}</label>
					<input id="{{rootId}}-armour" class="bastionland-box" type="number" name="system.armour" value="{{system.armour}}" min="0" step="1">
				</div>
			</section>
			<input class="bastionland-blank bastionland-npc-armour-note" type="text" name="system.armourNote" value="{{system.armourNote}}" placeholder="{{localize 'bastionland.structure.armourNote'}}" aria-label="{{localize 'bastionland.structure.armourNote'}}" autocomplete="off">

			<section class="bastionland-block">
				<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.structure.kind"}}</h2>
				<ul class="bastionland-choices bastionland-choices--inline">
					{{#each kinds}}
					<li>
						<button type="button" class="bastionland-choice{{#if active}} is-active{{/if}}" data-action="setKind" data-kind="{{key}}" data-tooltip="{{hint}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}}</button>
					</li>
					{{/each}}
				</ul>
				<p class="bastionland-hint">{{kindRules}}</p>
				{{#if isShip}}
				<label class="bastionland-structure__carries">
					<span class="bastionland-heading bastionland-heading--small">{{localize "bastionland.structure.carries"}}</span>
					<input class="bastionland-blank" type="text" name="system.carries" value="{{system.carries}}" placeholder="{{localize 'bastionland.structure.carriesPlaceholder'}}" autocomplete="off">
				</label>
				{{/if}}
			</section>

			<section class="bastionland-block">
				<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.conditions.label"}}</h2>
				<ul class="bastionland-conditions">
					<li>
						<span class="bastionland-condition is-derived{{#if system.destroyed}} is-active{{/if}}" data-tooltip="{{localize 'bastionland.structure.destroyed.hint'}}">{{localize "bastionland.structure.destroyed.label"}}</span>
					</li>
				</ul>
			</section>
		</div>

		<div class="bastionland-column">
			<section class="bastionland-block">
				<h2 class="bastionland-heading">{{localize "bastionland.structure.items"}}</h2>
				<ul class="bastionland-items">
					{{#each items}}
					{{> "bastionland.item-row"}}
					{{else}}
					<li class="bastionland-empty">{{localize "bastionland.sheet.empty"}}</li>
					{{/each}}
				</ul>
				<div class="bastionland-adds">
					{{#each addTypes}}
					{{> "bastionland.add-item"}}
					{{/each}}
				</div>
			</section>

			<section class="bastionland-block">
				<h2 class="bastionland-heading">{{localize "bastionland.npc.notes"}}</h2>
				{{#if editable}}
				<prose-mirror name="system.notes" value="{{system.notes}}" document-uuid="{{actor.uuid}}" toggled="true">{{{enrichedNotes}}}</prose-mirror>
				{{else}}
				<div class="editor-content">{{{enrichedNotes}}}</div>
				{{/if}}
			</section>
		</div>
	</div>
</div>
