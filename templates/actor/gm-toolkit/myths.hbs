{{!-- Each of the Realm's Myths: the Omen playing out, the one to come, its table and the GM's notes; then the City Quest. --}}
<section class="tab bastionland-page bastionland-gm-toolkit__page {{tab.cssClass}}" data-group="primary" data-tab="myths">
	{{!-- An Omen's text, with each "see opposite" opening the Myth's table. --}}
	{{#*inline "omenText"}}{{#each parts}}{{#if opposite}}<a class="bastionland-gm-toolkit__opposite" data-action="showMythTable" data-tooltip="{{localize 'bastionland.gmToolkit.myths.showTable'}}">{{text}}</a>{{else}}{{text}}{{/if}}{{/each}}{{/inline}}
	<p class="bastionland-hint">{{localize "bastionland.gmToolkit.myths.hint"}}</p>

	{{#if noRealm}}
	<p class="bastionland-empty">{{localize "bastionland.myths.noRealm"}}</p>
	{{else}}
	{{#if missingText}}
	<p class="bastionland-hint">{{localize "bastionland.gmToolkit.myths.noText"}}</p>
	{{/if}}

	{{#each myths}}
	{{!-- Folded, a Myth is one row that says where it has got to. Opening one folds the one open before. --}}
	<details class="bastionland-gm-toolkit__card bastionland-gm-toolkit__myth{{#if resolved}} is-resolved{{/if}}" name="{{@root.mythGroup}}" data-number="{{number}}" data-fold="{{fold}}" data-myth-card {{#if open}}open{{/if}}>
		<summary class="bastionland-gm-toolkit__myth-head">
			{{#if img}}
			{{!-- A button, so a click opens the picture rather than the card. --}}
			<button type="button" class="bastionland-gm-toolkit__art" data-action="showMythArt" data-tooltip="{{localize 'bastionland.gmToolkit.myths.showArt'}}" aria-label="{{localize 'bastionland.gmToolkit.myths.showArt'}}"><img src="{{img}}" alt=""></button>
			{{/if}}
			<span class="bastionland-gm-toolkit__name">{{number}}. {{name}}</span>
			<span class="bastionland-gm-toolkit__pips" role="img" aria-label="{{seen}}" data-tooltip="{{seen}}">
				{{#each omens}}<i class="bastionland-gm-toolkit__pip{{#if met}} is-met{{/if}}{{#if current}} is-current{{/if}}"></i>{{/each}}
			</span>
			{{!-- The verse under the Myth's name in the book, its two lines run into one. --}}
			{{#if verse}}
			<span class="bastionland-gm-toolkit__verse" data-tooltip="{{verse}}">{{verse}}</span>
			{{/if}}
			<span class="bastionland-gm-toolkit__chips">
				<button type="button" class="bastionland-gm-toolkit__chip bastionland-gm-toolkit__chip--button" data-action="showHex" data-hex="{{hexKey}}" data-tooltip="{{localize 'bastionland.gmToolkit.showHex'}}"><i class="fa-solid fa-location-dot" inert></i> {{hex}}</button>
				{{#if hidden}}
				<span class="bastionland-gm-toolkit__chip is-hidden">{{localize "bastionland.realm.panel.hidden"}}</span>
				{{/if}}
				{{#if resolved}}
				<span class="bastionland-gm-toolkit__chip is-resolved"><i class="fa-solid fa-crown" inert></i> {{localize "bastionland.gmToolkit.myths.resolved"}}</span>
				{{/if}}
			</span>
		</summary>

		<div class="bastionland-gm-toolkit__myth-body">
			<p class="bastionland-hint">{{#if reference}}{{reference}} · {{/if}}{{seen}} · {{localize "bastionland.gmToolkit.myths.clickOmen"}}</p>

			{{#if resolved}}
			<p class="bastionland-gm-toolkit__resolved">{{localize "bastionland.gmToolkit.myths.resolvedHint"}}</p>
			{{/if}}

			{{!-- The six Omens in order. Clicking the one the Company has met marks
			      it and crosses out the ones before it; clicking it again takes it
			      back. The one playing out and the one to come are written out;
			      each other is cut to a line, which hovering reads in full. --}}
			<ol class="bastionland-gm-toolkit__omens">
				{{#each omens}}
				<li class="bastionland-gm-toolkit__omen{{#if past}} is-past{{/if}}{{#if current}} is-current{{/if}}{{#if next}} is-next{{/if}}{{#if cut}} is-cut{{/if}}" data-action="markOmen" data-omen="{{number}}">
					<button type="button" class="bastionland-gm-toolkit__omen-number" data-action="markOmen" data-omen="{{number}}" aria-label="{{mark}}"><span>{{number}}</span></button>
					<div class="bastionland-gm-toolkit__omen-text">
						{{#if label}}<span class="bastionland-gm-toolkit__omen-label">{{label}}</span>{{/if}}
						<p>{{> omenText this}}</p>
					</div>
				</li>
				{{/each}}
			</ol>
			{{#if complete}}
			<p class="bastionland-hint">{{localize "bastionland.realm.wilderness.omensComplete"}}</p>
			{{/if}}

			{{#with cast}}
			{{> "bastionland.gm-toolkit-cast"}}
			{{/with}}

			{{#with table}}
			<details class="bastionland-gm-toolkit__fold bastionland-gm-toolkit__table-fold" data-fold="{{fold}}" data-myth-fold {{#if open}}open{{/if}}>
				<summary>{{#if name}}{{name}}{{else}}{{localize "bastionland.gmToolkit.myths.table"}}{{/if}}</summary>
				{{#if rows}}
				<table class="bastionland-myth-table" data-myth-table>
					<thead>
						<tr>
							<th scope="col" class="bastionland-myth-table__die"><button type="button" data-action="rollMythTable" data-tooltip="{{localize 'bastionland.gmToolkit.myths.rollTable'}}" aria-label="{{localize 'bastionland.gmToolkit.myths.rollTable'}}"><i class="fa-solid fa-dice-d6" inert></i></button></th>
							{{#each columns}}
							<th scope="col"><button type="button" data-action="rollMythTable" data-column="{{index}}" data-tooltip="{{tooltip}}">{{label}}</button></th>
							{{/each}}
						</tr>
					</thead>
					<tbody>
						{{#each rows}}
						<tr>
							<th scope="row">{{number}}</th>
							{{#each entries}}
							<td data-column="{{column}}"{{#if rolled}} class="is-rolled"{{/if}}>{{text}}</td>
							{{/each}}
						</tr>
						{{/each}}
					</tbody>
				</table>
				{{else if reading}}
				<p class="bastionland-hint">{{localize "bastionland.gmToolkit.myths.tableReading"}}</p>
				{{else}}
				<p class="bastionland-hint">{{localize "bastionland.gmToolkit.myths.tableMissing"}}</p>
				{{/if}}
			</details>
			{{/with}}

			<label class="bastionland-gm-toolkit__note">
				<span>{{localize "bastionland.gmToolkit.myths.note"}}</span>
				<textarea data-toolkit-field="mythNote" rows="2" placeholder="{{localize 'bastionland.gmToolkit.myths.notePlaceholder'}}">{{note}}</textarea>
			</label>

			<nav class="bastionland-toolbar" aria-label="{{name}}">
				{{#if table.rows}}
				<button type="button" data-action="rollMythTable"><i class="fa-solid fa-dice-d6" inert></i> {{localize "bastionland.gmToolkit.myths.rollTable"}}</button>
				{{/if}}
				{{#if resolved}}
				<button type="button" data-action="newMyth" data-tooltip="{{localize 'bastionland.gmToolkit.myths.newMythTooltip'}}"><i class="fa-solid fa-dice" inert></i> {{localize "bastionland.gmToolkit.myths.newMyth"}}</button>
				<button type="button" data-action="mythUnresolved"><i class="fa-solid fa-rotate-left" inert></i> {{localize "bastionland.gmToolkit.myths.unresolve"}}</button>
				{{else}}
				<button type="button" data-action="mythResolved" data-tooltip="{{localize 'bastionland.glory.awards.myth.hint'}}"><i class="fa-solid fa-crown" inert></i> {{localize "bastionland.glory.awards.myth.label"}}</button>
				{{/if}}
			</nav>
		</div>
	</details>
	{{else}}
	<p class="bastionland-empty">{{localize "bastionland.myths.noMyths"}}</p>
	{{/each}}

	{{#if myths.length}}
	{{!-- Which six the Realm holds, chosen apart from play: rolled again, or picked from the book's table. --}}
	<nav class="bastionland-toolbar" aria-label="{{localize 'bastionland.gmToolkit.myths.choose'}}">
		<button type="button" data-action="settleMyths" data-tooltip="{{localize 'bastionland.gmToolkit.myths.chooseTooltip'}}"><i class="fa-solid fa-dragon" inert></i> {{localize "bastionland.gmToolkit.myths.choose"}}</button>
	</nav>
	{{/if}}
	{{/if}}

	<section class="bastionland-gm-toolkit__card bastionland-myths__city" data-cast-key="{{cityQuest.cast.key}}">
		<h2 class="bastionland-heading">{{localize "bastionland.cityQuest.title"}}</h2>
		<p class="bastionland-hint">{{localize "bastionland.cityQuest.hint"}}</p>
		{{#if cityQuest.missingText}}
		<p class="bastionland-hint">{{localize "bastionland.cityQuest.noText"}}</p>
		{{/if}}
		<p>{{cityQuest.seen}}</p>
		{{#unless cityQuest.empty}}
		<ol class="bastionland-myths__omens bastionland-myths__omens--city">
			{{#each cityQuest.omens}}
			<li class="is-seen"><strong>{{number}}.</strong> {{text}}</li>
			{{/each}}
		</ol>
		{{/unless}}
		{{#with cityQuest.cast}}
		{{> "bastionland.gm-toolkit-cast"}}
		{{/with}}
		{{#if cityQuest.over}}
		<p class="bastionland-card__outcome">{{localize "bastionland.cityQuest.over"}}</p>
		{{/if}}
		<nav class="bastionland-toolbar" aria-label="{{localize 'bastionland.cityQuest.title'}}">
			<button type="button" data-action="rollCityOmen" {{disabled cityQuest.over}}><i class="fa-solid fa-dice-d20" inert></i> {{localize "bastionland.cityQuest.roll"}}</button>
			<button type="button" data-action="resetCityQuest" {{disabled cityQuest.empty}}><i class="fa-solid fa-rotate-left" inert></i> {{localize "bastionland.cityQuest.reset"}}</button>
		</nav>
	</section>
</section>
