<div class="bastionland-page bastionland-page--tabbed">
	<header class="bastionland-header">
		<figure class="bastionland-portrait" {{#unless hasArt}}data-tooltip="{{localize 'bastionland.sheet.portrait'}}"{{/unless}}>
			<img src="{{actor.img}}" alt="{{actor.name}}" {{#if portraitStyle}}style="{{portraitStyle}}"{{/if}} {{#if hasArt}}data-name="{{actor.name}}"{{/if}} {{#if (or hasArt editable)}}data-action="openPortrait"{{/if}}>
		</figure>
		<div class="bastionland-header__text">
			<div class="bastionland-title-row">
				<h1 class="bastionland-title">{{localize "bastionland.sheet.title"}}</h1>
				<button type="button" class="bastionland-icon bastionland-knighthood-help" data-action="showKnighthood" aria-label="{{localize 'bastionland.knighthood.button'}}">
					<i class="fa-solid fa-circle-question" inert></i>
				</button>
			</div>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-name">{{localize "bastionland.sheet.named"}}</label>
				<input id="{{rootId}}-name" class="bastionland-blank" type="text" name="name" value="{{actor.name}}" autocomplete="off" spellcheck="false">
			</p>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-type">{{localize "bastionland.sheet.knownAs"}}</label>
				<input id="{{rootId}}-type" class="bastionland-blank bastionland-blank--short" type="text" name="system.knightType" value="{{system.knightType}}" autocomplete="off">
				<span class="bastionland-script">{{localize "bastionland.sheet.knight"}}</span>
			</p>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-seer">{{localize "bastionland.sheet.knightedBy"}}</label>
				<input id="{{rootId}}-seer" class="bastionland-blank" type="text" name="system.seer" value="{{system.seer}}" autocomplete="off">
			</p>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-fate">{{localize "bastionland.sheet.fate"}}</label>
				<input id="{{rootId}}-fate" class="bastionland-blank" type="text" name="system.fate" value="{{system.fate}}" autocomplete="off">
			</p>
		</div>
		<figure class="bastionland-heraldry" data-tooltip="{{localize (ifThen editable 'bastionland.heraldry.paint' 'bastionland.sheet.heraldry')}}">
			{{#if editable}}
			<button type="button" class="bastionland-heraldry__field" data-action="paintHeraldry" aria-label="{{localize 'bastionland.heraldry.paint'}}">
				{{#if system.heraldry}}<img src="{{system.heraldry}}" alt="">{{/if}}
			</button>
			{{else}}
			<span class="bastionland-heraldry__field">
				{{#if system.heraldry}}<img src="{{system.heraldry}}" alt="{{localize 'bastionland.sheet.heraldry'}}">{{/if}}
			</span>
			{{/if}}
		</figure>
		{{#if editable}}
		<nav class="bastionland-toolbar bastionland-toolbar--actions" aria-label="{{localize 'bastionland.sheet.title'}}">
			<button type="button" data-action="attack"><i class="fa-solid fa-swords" inert></i> <span>{{localize "bastionland.sheet.attack"}}</span></button>
			<button type="button" data-action="duel" data-tooltip="{{localize 'bastionland.duel.buttonHint'}}"><i class="fa-solid fa-hand-fist" inert></i> <span>{{localize "bastionland.duel.title"}}</span></button>
			<button type="button" data-action="takeDamage"><i class="fa-solid fa-heart-crack" inert></i> <span>{{localize "bastionland.sheet.takeDamage"}}</span></button>
		</nav>
		{{/if}}
	</header>

	<div class="tab {{tabs.knight.cssClass}}" data-group="primary" data-tab="knight">
		<div class="bastionland-columns">
			<div class="bastionland-column">
				<section class="bastionland-scores" data-block="scores" style="--bastionland-narrow-order: 1">
					{{> "bastionland.virtue-scores"}}

					{{!-- The Property page's Armour, repeated beside VIG where the blows land. --}}
					<span class="bastionland-armour bastionland-armour--score" data-tooltip="{{localize 'bastionland.sheet.armour'}}">
						<i class="fa-solid fa-shield-halved" inert></i> A{{system.armour}}
					</span>

					<div class="bastionland-score">
						<label class="bastionland-score__name bastionland-score__name--word" for="{{rootId}}-glory" data-tooltip="{{localize 'bastionland.glory.hint'}}">{{localize "bastionland.glory.label"}}</label>
						<input id="{{rootId}}-glory" class="bastionland-box" type="number" name="system.glory" value="{{system.glory}}" min="0" step="1">
					</div>
				</section>

				<section class="bastionland-block" data-block="conditions" style="--bastionland-narrow-order: 2">
					<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.conditions.label"}}</h2>
					<ul class="bastionland-conditions">
						{{> "bastionland.condition-items"}}
					</ul>
				</section>

				<section class="bastionland-block" data-block="recovery" style="--bastionland-narrow-order: 7">
					{{> "bastionland.recovery-list"}}
				</section>

				<div class="bastionland-pair" data-block="age" style="--bastionland-narrow-order: 9">
					{{> "bastionland.age-choices"}}
					<section class="bastionland-block">
						<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.rank.hint'}}">{{localize "bastionland.rank.label"}}</h2>
						<ul class="bastionland-choices">
							{{#each ranks}}
							<li class="bastionland-choice bastionland-choice--static{{#if active}} is-active{{/if}}" data-tooltip="{{worthy}}">
								{{label}} <span class="bastionland-choice__glory">{{glory}}</span>
							</li>
							{{/each}}
						</ul>
						{{#if worthyOf}}<p class="bastionland-hint bastionland-worthy">{{worthyOf}}</p>{{/if}}
						<p class="bastionland-hint">{{nextRank}}</p>
					</section>
				</div>

				<section class="bastionland-block" data-block="squire" style="--bastionland-narrow-order: 10">
					<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.successor.hint'}}">{{localize "bastionland.successor.label"}}</h2>
					{{#if successor}}
					<div class="bastionland-steed">
						<img class="bastionland-steed__img" src="{{successor.img}}" alt="">
						<button type="button" class="bastionland-item__name" data-action="openSuccessor">{{successor.name}}</button>
						{{#if editable}}
						<button type="button" class="bastionland-icon" data-action="clearSuccessor" data-tooltip="{{localize 'bastionland.successor.clear'}}" aria-label="{{localize 'bastionland.successor.clear'}}">
							<i class="fa-solid fa-xmark" inert></i>
						</button>
						{{/if}}
					</div>
					{{else}}
					<p class="bastionland-empty">{{localize "bastionland.successor.empty"}}</p>
					{{#if editable}}
					<div class="bastionland-adds">
						<button type="button" class="bastionland-button" data-action="nameSuccessor"><i class="fa-solid fa-crown" inert></i> {{localize "bastionland.successor.name"}}</button>
					</div>
					{{/if}}
					{{/if}}
				</section>
			</div>

			<div class="bastionland-column">
				{{!-- A Squire's sheet leaves these out unless they carry one already. --}}
				{{#if (or abilities.length canAddAbility)}}
				<section class="bastionland-block" data-block="property" style="--bastionland-narrow-order: 3">
					<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.ability.hint'}}">{{localize "bastionland.ability.label"}}</h2>
					<ul class="bastionland-items bastionland-items--prose bastionland-items--named">
						{{#each abilities}}
						{{> "bastionland.item-row"}}
						{{/each}}
					</ul>
					{{#if canAddAbility}}
					<div class="bastionland-adds">
						{{> "bastionland.add-item" type="ability" label=(localize "TYPES.Item.ability")}}
					</div>
					{{/if}}
				</section>
				{{/if}}

				{{#if (or passions.length canAddPassion)}}
				<section class="bastionland-block" data-block="passions" style="--bastionland-narrow-order: 4">
					<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.passion.hint'}}">{{localize "bastionland.passion.label"}}</h2>
					<ul class="bastionland-items bastionland-items--prose bastionland-items--named">
						{{#each passions}}
						{{> "bastionland.item-row"}}
						{{/each}}
					</ul>
					{{#if canAddPassion}}
					<div class="bastionland-adds">
						{{> "bastionland.add-item" type="passion" label=(localize "TYPES.Item.passion")}}
					</div>
					{{/if}}
				</section>
				{{/if}}

				<section class="bastionland-block" data-block="feats" style="--bastionland-narrow-order: 5">
					<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.feats.knightHint'}}">{{localize "bastionland.feats.label"}}</h2>
					{{> "bastionland.feat-list"}}
				</section>

				<section class="bastionland-block" data-block="gambits" style="--bastionland-narrow-order: 6">
					{{> "bastionland.gambit-list"}}
				</section>

				<section class="bastionland-block" data-block="scars" style="--bastionland-narrow-order: 8">
					{{> "bastionland.scar-list"}}
				</section>
			</div>

			<section class="bastionland-oath" data-block="oath" style="--bastionland-narrow-order: 11">
				<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.oath.hint'}}">{{localize "bastionland.oath.label"}}</h2>
				<p>{{localize "bastionland.oath.line1"}}</p>
				<p>{{localize "bastionland.oath.line2"}}</p>
				<p>{{localize "bastionland.oath.line3"}}</p>
			</section>
		</div>
	</div>

	<div class="tab {{tabs.property.cssClass}}" data-group="primary" data-tab="property">
		{{!-- Whatever carries the Knight's goods, which the page's tab shows, then what they own. --}}
		<div class="bastionland-columns bastionland-columns--wide-last">
			<div class="bastionland-column">
				{{> "bastionland.steed-block"}}
				<section class="bastionland-block">
					<h2 class="bastionland-heading">{{localize "bastionland.squire.label"}}</h2>
					{{#if squire}}
					<div class="bastionland-steed">
						<img class="bastionland-steed__img" src="{{squire.img}}" alt="">
						<button type="button" class="bastionland-item__name" data-action="openSquire">{{squire.name}}</button>
						{{#if editable}}
						<button type="button" class="bastionland-icon" data-action="clearSquire" data-tooltip="{{localize 'bastionland.squire.clear'}}" aria-label="{{localize 'bastionland.squire.clear'}}">
							<i class="fa-solid fa-xmark" inert></i>
						</button>
						{{/if}}
					</div>
					{{else}}
					<p class="bastionland-empty">{{squireEmpty}}</p>
					{{#if editable}}
					<div class="bastionland-adds">
						<button type="button" class="bastionland-button" data-action="takeSquire"{{#if squireBarred}} disabled{{/if}}><i class="fa-solid fa-user-plus" inert></i> {{localize "bastionland.squire.take"}}</button>
					</div>
					{{/if}}
					{{/if}}
				</section>
			</div>

			<div class="bastionland-column">
				<section class="bastionland-block">
					<header class="bastionland-block__header">
						<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.property.hint'}}">{{localize "bastionland.property.label"}}</h2>
						<span class="bastionland-armour" data-tooltip="{{localize 'bastionland.sheet.armour'}}">
							<i class="fa-solid fa-shield-halved" inert></i> A{{system.armour}}
						</span>
					</header>
					<ul class="bastionland-items bastionland-items--zebra">
						{{#each property}}
						{{> "bastionland.item-row"}}
						{{else}}
						<li class="bastionland-empty">{{localize "bastionland.sheet.empty"}}</li>
						{{/each}}
						{{#with bookTableRow}}
						{{!-- A table about the Knight themself, which no possession points to. --}}
						<li class="bastionland-item bastionland-item--book-table">
							<div class="bastionland-item__line"><span class="bastionland-item__title"><span class="bastionland-item__head">{{name}}</span></span></div>
							{{> "bastionland.book-table-line"}}
						</li>
						{{/with}}
					</ul>
					<div class="bastionland-adds">
						{{#each propertyTypes}}
						{{> "bastionland.add-item"}}
						{{/each}}
					</div>
				</section>
			</div>
		</div>
	</div>

	<div class="tab {{tabs.seer.cssClass}}" data-group="primary" data-tab="seer">
		<section class="bastionland-block bastionland-seer">
			<header class="bastionland-block__header">
				<h2 class="bastionland-heading">{{#if system.seer}}<small class="bastionland-seer__by">{{localize "bastionland.sheet.knightedBy"}}</small> {{system.seer}}{{else}}{{localize "bastionland.seer.label"}}{{/if}}</h2>
			</header>
			{{#unless system.seer}}
			<p class="bastionland-hint">{{localize "bastionland.seer.unnamed"}}</p>
			{{/unless}}
			<div class="bastionland-seer__body">
				{{#if (or system.seerImg editable)}}
				<figure class="bastionland-seer__portrait">
					{{#if system.seerImg}}
					<img src="{{system.seerImg}}" alt="{{system.seer}}" {{#if editable}}data-action="pickSeerImage" data-tooltip="{{localize 'bastionland.seer.portrait'}}"{{/if}}>
					{{else}}
					<button type="button" class="bastionland-seer__pick" data-action="pickSeerImage"><i class="fa-solid fa-image" inert></i> {{localize "bastionland.seer.portrait"}}</button>
					{{/if}}
				</figure>
				{{/if}}
				{{!-- The book's own words, unheaded as the book prints them: read only, and shown whole. --}}
				{{!-- Their stat line keeps the harm they've taken, each score out of the book's. Each Virtue rolls their Save. --}}
				{{#if system.seerInfo}}
				<div class="bastionland-seer__book">
					{{#with seerStats}}
					<div class="bastionland-seer__stats">
						{{#each scores}}
						<span class="bastionland-seer__score">
							{{#if rollLabel}}
							<button type="button" class="bastionland-seer__stat" data-action="rollSeerSave" data-virtue="{{key}}" data-tooltip="{{rollLabel}}" aria-label="{{rollLabel}}">{{abbr}}</button>
							{{else}}
							<span class="bastionland-seer__stat">{{abbr}}</span>
							{{/if}}
							<input class="bastionland-seer__value" type="number" name="system.seerState.{{key}}" value="{{value}}" min="0" step="1" aria-label="{{label}}"><span class="bastionland-seer__max">/{{max}}</span>
						</span>
						{{/each}}
						<button type="button" class="bastionland-condition{{#if mortalWound.active}} is-active{{/if}}" data-action="toggleSeerMortalWound" data-tooltip="{{mortalWound.hint}}" aria-pressed="{{#if mortalWound.active}}true{{else}}false{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{mortalWound.label}}</button>
						{{#if @root.editable}}
						<span class="bastionland-seer__tools">
							<button type="button" class="bastionland-icon" data-action="takeSeerDamage" data-tooltip="{{takeDamage}}" aria-label="{{takeDamage}}"><i class="fa-solid fa-heart-crack" inert></i></button>
							<button type="button" class="bastionland-icon" data-action="restoreSeer" data-tooltip="{{restore}}" aria-label="{{restore}}"><i class="fa-solid fa-rotate-left" inert></i></button>
						</span>
						{{/if}}
					</div>
					{{/with}}
					{{{enrichedSeerInfo}}}
				</div>
				{{else}}
				<p class="bastionland-hint">{{localize "bastionland.seer.infoEmpty"}}</p>
				{{/if}}
			</div>
		</section>

		<section class="bastionland-block bastionland-chronicle">
			<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.seer.notes"}}</h2>
			{{#if editable}}
			<prose-mirror name="system.seerNotes" value="{{system.seerNotes}}" document-uuid="{{actor.uuid}}" toggled="true">{{{enrichedSeerNotes}}}</prose-mirror>
			{{else}}
			<div class="editor-content">{{{enrichedSeerNotes}}}</div>
			{{/if}}
		</section>
	</div>

	{{> "bastionland.chronicle-tab"}}

	{{#if tabs.settings}}
	<div class="tab {{tabs.settings.cssClass}}" data-group="primary" data-tab="settings">
		{{> "bastionland.settings-tab"}}
	</div>
	{{/if}}
</div>
