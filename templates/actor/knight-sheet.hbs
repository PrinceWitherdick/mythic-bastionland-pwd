<div class="bastionland-page bastionland-page--tabbed">
	<header class="bastionland-header">
		<figure class="bastionland-portrait" {{#unless hasArt}}data-tooltip="{{localize 'bastionland.sheet.portrait'}}"{{/unless}}>
			<img src="{{actor.img}}" alt="{{actor.name}}" {{#if hasArt}}data-name="{{actor.name}}"{{/if}} {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
		</figure>
		<div class="bastionland-header__text">
			<h1 class="bastionland-title">{{localize "bastionland.sheet.title"}}</h1>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-name">{{localize "bastionland.sheet.named"}}</label>
				<input id="{{rootId}}-name" class="bastionland-blank" type="text" name="name" value="{{actor.name}}" autocomplete="off" spellcheck="false">
			</p>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-type">{{localize "bastionland.sheet.knownAs"}}</label>
				<input id="{{rootId}}-type" class="bastionland-blank bastionland-blank--short" type="text" name="system.knightType" value="{{system.knightType}}" autocomplete="off">
				<span class="bastionland-script">{{localize "bastionland.sheet.knight"}}</span>
			</p>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-seer">{{localize "bastionland.sheet.knightedBy"}}</label>
				<input id="{{rootId}}-seer" class="bastionland-blank" type="text" name="system.seer" value="{{system.seer}}" autocomplete="off">
			</p>
			<p class="bastionland-line">
				<label class="bastionland-script" for="{{rootId}}-fate">{{localize "bastionland.sheet.fate"}}</label>
				<input id="{{rootId}}-fate" class="bastionland-blank" type="text" name="system.fate" value="{{system.fate}}" autocomplete="off">
			</p>
		</div>
		<figure class="bastionland-heraldry" data-tooltip="{{localize (ifThen editable 'bastionland.heraldry.paint' 'bastionland.sheet.heraldry')}}">
			{{#if editable}}
			<button type="button" class="bastionland-heraldry__field" data-action="paintHeraldry" aria-label="{{localize 'bastionland.heraldry.paint'}}">
				{{#if system.heraldry}}<img src="{{system.heraldry}}" alt="">{{/if}}
			</button>
			{{else}}
			<span class="bastionland-heraldry__field">
				{{#if system.heraldry}}<img src="{{system.heraldry}}" alt="{{localize 'bastionland.sheet.heraldry'}}">{{/if}}
			</span>
			{{/if}}
		</figure>
	</header>

	{{#if editable}}
	<nav class="bastionland-toolbar bastionland-toolbar--actions" aria-label="{{localize 'bastionland.sheet.title'}}">
		<button type="button" data-action="attack"><i class="fa-solid fa-swords" inert></i> <span>{{localize "bastionland.sheet.attack"}}</span></button>
		<button type="button" data-action="duel" data-tooltip="{{localize 'bastionland.duel.buttonHint'}}"><i class="fa-solid fa-hand-fist" inert></i> <span>{{localize "bastionland.duel.title"}}</span></button>
		<button type="button" data-action="takeDamage"><i class="fa-solid fa-heart-crack" inert></i> <span>{{localize "bastionland.sheet.takeDamage"}}</span></button>
	</nav>
	{{/if}}

	<div class="tab {{tabs.knight.cssClass}}" data-group="primary" data-tab="knight">
		<div class="bastionland-columns">
			<div class="bastionland-column">
				<section class="bastionland-scores">
					{{> "bastionland.virtue-scores"}}

					{{#unless isSquire}}
					<div class="bastionland-score">
						<label class="bastionland-score__name bastionland-score__name--word" for="{{rootId}}-glory">{{localize "bastionland.glory.label"}}</label>
						<input id="{{rootId}}-glory" class="bastionland-box" type="number" name="system.glory" value="{{system.glory}}" min="0" step="1">
					</div>
					{{/unless}}
				</section>

				<div class="bastionland-pair">
					<section class="bastionland-block">
						<h2 class="bastionland-heading">{{localize "bastionland.age.label"}}</h2>
						<ul class="bastionland-choices">
							{{#each ages}}
							<li>
								<button type="button" class="bastionland-choice{{#if active}} is-active{{/if}}" data-action="setAge" data-age="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}}</button>
							</li>
							{{/each}}
						</ul>
					</section>

					<section class="bastionland-block">
						<h2 class="bastionland-heading">{{localize "bastionland.rank.label"}}</h2>
						{{#if isSquire}}
						<p class="bastionland-hint">{{localize "bastionland.squire.hint"}}</p>
						{{else}}
						<ul class="bastionland-choices">
							{{#each ranks}}
							<li class="bastionland-choice bastionland-choice--static{{#if active}} is-active{{/if}}">
								{{label}} <span class="bastionland-choice__glory">{{glory}}</span>
							</li>
							{{/each}}
						</ul>
						<p class="bastionland-hint">{{nextRank}}</p>
						{{/if}}
					</section>
				</div>

				<section class="bastionland-block">
					<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.conditions.label"}}</h2>
					<ul class="bastionland-conditions">
						{{> "bastionland.condition-items"}}
					</ul>
				</section>

				<section class="bastionland-block">
					<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.recovery.label"}}</h2>
					<ul class="bastionland-recovery">
						{{#each virtues}}
						<li>
							<span><strong>{{abbr}}</strong> – {{recovery}}</span>
							{{#if @root.editable}}
							<button type="button" class="bastionland-icon" data-action="restore" data-virtue="{{key}}" data-tooltip="{{restoreLabel}}" aria-label="{{restoreLabel}}">
								<i class="fa-solid fa-heart-pulse" inert></i>
							</button>
							{{/if}}
						</li>
						{{/each}}
						<li>
							<span><strong>{{localize "bastionland.recovery.guardLabel"}}</strong> – {{localize "bastionland.recovery.guard"}}</span>
							{{#if editable}}
							<button type="button" class="bastionland-icon" data-action="rest" data-tooltip="{{localize 'bastionland.sheet.rest'}}" aria-label="{{localize 'bastionland.sheet.rest'}}">
								<i class="fa-solid fa-mug-hot" inert></i>
							</button>
							{{/if}}
						</li>
					</ul>
				</section>
			</div>

			<div class="bastionland-column">
				<section class="bastionland-block">
					<header class="bastionland-block__header">
						<h2 class="bastionland-heading">{{localize "bastionland.property.label"}}</h2>
						<span class="bastionland-armour" data-tooltip="{{localize 'bastionland.sheet.armour'}}">
							<i class="fa-solid fa-shield-halved" inert></i> A{{system.armour}}
						</span>
					</header>
					<ul class="bastionland-items">
						{{#each property}}
						{{> "bastionland.item-row"}}
						{{else}}
						<li class="bastionland-empty">{{localize "bastionland.sheet.empty"}}</li>
						{{/each}}
					</ul>
					<div class="bastionland-adds">
						{{#each propertyTypes}}
						{{> "bastionland.add-item"}}
						{{/each}}
					</div>
				</section>

				<section class="bastionland-block">
					<h2 class="bastionland-heading">{{localize "bastionland.steed.label"}}</h2>
					{{#if steed}}
					<div class="bastionland-steed">
						<img class="bastionland-steed__img" src="{{steed.img}}" alt="">
						<button type="button" class="bastionland-item__name" data-action="openSteed">{{steed.name}}</button>
						{{#if steed.trample}}
						<span class="bastionland-item__tags">({{steed.trample}})</span>
						{{/if}}
						{{#if editable}}
						<button type="button" class="bastionland-icon" data-action="clearSteed" data-tooltip="{{localize 'bastionland.steed.clear'}}" aria-label="{{localize 'bastionland.steed.clear'}}">
							<i class="fa-solid fa-xmark" inert></i>
						</button>
						{{/if}}
					</div>
					{{else}}
					<p class="bastionland-empty">{{localize "bastionland.steed.empty"}}</p>
					{{/if}}
				</section>

				<section class="bastionland-block">
					<h2 class="bastionland-heading">{{localize "bastionland.squire.label"}}</h2>
					{{#if squire}}
					<div class="bastionland-steed">
						<img class="bastionland-steed__img" src="{{squire.img}}" alt="">
						<button type="button" class="bastionland-item__name" data-action="openSquire">{{squire.name}}</button>
						{{#if editable}}
						<button type="button" class="bastionland-icon" data-action="clearSquire" data-tooltip="{{localize 'bastionland.squire.clear'}}" aria-label="{{localize 'bastionland.squire.clear'}}">
							<i class="fa-solid fa-xmark" inert></i>
						</button>
						{{/if}}
					</div>
					{{else}}
					<p class="bastionland-empty">{{squireEmpty}}</p>
					{{#if editable}}{{#unless isSquire}}
					<div class="bastionland-adds">
						<button type="button" class="bastionland-button" data-action="takeSquire"><i class="fa-solid fa-user-plus" inert></i> {{localize "bastionland.squire.take"}}</button>
					</div>
					{{/unless}}{{/if}}
					{{/if}}
				</section>

				{{#unless isSquire}}
				<section class="bastionland-block">
					<h2 class="bastionland-heading" data-tooltip="{{localize 'bastionland.successor.hint'}}">{{localize "bastionland.successor.label"}}</h2>
					{{#if successor}}
					<div class="bastionland-steed">
						<img class="bastionland-steed__img" src="{{successor.img}}" alt="">
						<button type="button" class="bastionland-item__name" data-action="openSuccessor">{{successor.name}}</button>
						{{#if editable}}
						<button type="button" class="bastionland-icon" data-action="clearSuccessor" data-tooltip="{{localize 'bastionland.successor.clear'}}" aria-label="{{localize 'bastionland.successor.clear'}}">
							<i class="fa-solid fa-xmark" inert></i>
						</button>
						{{/if}}
					</div>
					{{else}}
					<p class="bastionland-empty">{{localize "bastionland.successor.empty"}}</p>
					{{#if editable}}
					<div class="bastionland-adds">
						<button type="button" class="bastionland-button" data-action="nameSuccessor"><i class="fa-solid fa-crown" inert></i> {{localize "bastionland.successor.name"}}</button>
					</div>
					{{/if}}
					{{/if}}
				</section>
				{{/unless}}

				{{!-- A Squire's sheet leaves these out unless they carry one already. --}}
				{{#if (or abilities.length canAddAbility)}}
				<section class="bastionland-block">
					<h2 class="bastionland-heading">{{localize "bastionland.ability.label"}}</h2>
					<ul class="bastionland-items bastionland-items--prose">
						{{#each abilities}}
						{{> "bastionland.item-row"}}
						{{/each}}
					</ul>
					{{#if canAddAbility}}
					<div class="bastionland-adds">
						{{> "bastionland.add-item" type="ability" label=(localize "TYPES.Item.ability")}}
					</div>
					{{/if}}
				</section>
				{{/if}}

				{{#if (or passions.length canAddPassion)}}
				<section class="bastionland-block">
					<h2 class="bastionland-heading">{{localize "bastionland.passion.label"}}</h2>
					<ul class="bastionland-items bastionland-items--prose">
						{{#each passions}}
						{{> "bastionland.item-row"}}
						{{/each}}
					</ul>
					{{#if canAddPassion}}
					<div class="bastionland-adds">
						{{> "bastionland.add-item" type="passion" label=(localize "TYPES.Item.passion")}}
					</div>
					{{/if}}
				</section>
				{{/if}}

				<section class="bastionland-block">
					<h2 class="bastionland-heading">{{localize "bastionland.scars.label"}}</h2>
					<ul class="bastionland-items bastionland-items--prose">
						{{#each scars}}
						{{> "bastionland.item-row"}}
						{{/each}}
					</ul>
					{{#if editable}}
					<div class="bastionland-adds">
						<button type="button" class="bastionland-add" data-action="rollScar"><i class="fa-solid fa-bone-break" inert></i> {{localize "bastionland.sheet.rollScar"}}</button>
					</div>
					{{/if}}
				</section>
			</div>

			{{!-- Feats and Gambits share a grid row so their headings line up. --}}
			<section class="bastionland-block">
				<h2 class="bastionland-heading">{{localize "bastionland.feats.label"}}</h2>
				{{#if isSquire}}
				<p class="bastionland-hint">{{localize "bastionland.squire.noFeats"}}</p>
				{{else}}
				{{> "bastionland.feat-list"}}
				{{/if}}
			</section>

			<section class="bastionland-block">
				<h2 class="bastionland-heading">{{localize "bastionland.gambits.label"}}</h2>
				<ul class="bastionland-gambits">
					{{#each gambits}}
					<li>{{{this}}}</li>
					{{/each}}
				</ul>
				<p class="bastionland-hint">{{localize "bastionland.gambits.hint"}}</p>
				<p class="bastionland-hint">{{{localize "bastionland.gambits.strong"}}}</p>
			</section>

			<section class="bastionland-oath">
				<h2 class="bastionland-heading">{{localize "bastionland.oath.label"}}</h2>
				<p>{{localize "bastionland.oath.line1"}}</p>
				<p>{{localize "bastionland.oath.line2"}}</p>
				<p>{{localize "bastionland.oath.line3"}}</p>
			</section>
		</div>
	</div>

	<div class="tab {{tabs.chronicle.cssClass}}" data-group="primary" data-tab="chronicle">
		<section class="bastionland-block bastionland-chronicle">
			<h2 class="bastionland-heading">{{localize "bastionland.sheet.chronicle"}}</h2>
			{{#if editable}}
			<prose-mirror name="system.notes" value="{{system.notes}}" document-uuid="{{actor.uuid}}" toggled="true">{{{enrichedNotes}}}</prose-mirror>
			{{else}}
			<div class="editor-content">{{{enrichedNotes}}}</div>
			{{/if}}
		</section>
	</div>
</div>
