{{!-- The Gambits anyone may spend an Attack die on, Knighted or not, each posting its rule to chat. --}}
					<h2 class="bastionland-heading">{{localize "bastionland.gambits.label"}}</h2>
					<ul class="bastionland-gambits">
						{{#each gambits}}
						<li>
							<button type="button" class="bastionland-move" data-action="postGambit" data-gambit="{{key}}" data-viewable>
								<span class="bastionland-move__text">{{{label}}}</span>
							</button>
						</li>
						{{/each}}
					</ul>
					<p class="bastionland-hint">{{localize "bastionland.gambits.hint"}}</p>
					<p class="bastionland-hint">{{{localize "bastionland.gambits.strong"}}}</p>
