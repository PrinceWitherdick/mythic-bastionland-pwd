{{!-- A page of notes filling the window: the Chronicle on the Knight sheet and the Squire's, the Notes on a Domain's and an NPC's. Takes the tab's id and the heading's key. --}}
<div class="tab {{lookup (lookup tabs tab) "cssClass"}}" data-group="primary" data-tab="{{tab}}">
	<section class="bastionland-block bastionland-chronicle">
		<h2 class="bastionland-heading">{{localize heading}}</h2>
		{{#if editable}}
		<prose-mirror name="system.notes" value="{{system.notes}}" document-uuid="{{actor.uuid}}" toggled="true">{{{enrichedNotes}}}</prose-mirror>
		{{else}}
		<div class="editor-content">{{{enrichedNotes}}}</div>
		{{/if}}
	</section>
</div>
