{{!-- The table on a Knight's page, as their Property shows it: a die that opens it in its own window, and what it gave, each told as a sentence where the table has one. Two or more lines take a line each. --}}
<p class="bastionland-item__book-table{{#if results.[1]}} is-several{{/if}}"><button type="button" class="bastionland-item__book-roll" data-action="openKnightTable" data-viewable data-tooltip="{{tooltip}}" aria-label="{{tooltip}}"><i class="fa-solid fa-dice-d6" inert></i></button>{{#each results}} <span class="bastionland-item__book-result">{{#if sentence}}{{> "bastionland.table-sentence" parts=sentence.parts}}{{else}}{{column}}: <strong>{{entry}}</strong>{{/if}}</span>{{/each}}</p>
