<header class="bastionland-npc-header">
	<img class="bastionland-npc-header__img" src="{{actor.img}}" alt="{{actor.name}}" {{#if hasArt}}data-name="{{actor.name}}"{{/if}} {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
	<div class="bastionland-npc-header__text">
		<input class="bastionland-npc-header__name" type="text" name="name" value="{{actor.name}}" aria-label="{{localize 'bastionland.npc.name'}}" autocomplete="off" spellcheck="false">
		<input class="bastionland-blank bastionland-npc-header__epithet" type="text" name="system.epithet" value="{{system.epithet}}" placeholder="{{localize 'bastionland.npc.epithet'}}" aria-label="{{localize 'bastionland.npc.epithet'}}" autocomplete="off">
		{{#if ownedBy}}
		<p class="bastionland-npc-header__owner">
			<span class="bastionland-npc-header__owner-label">{{localize "bastionland.npc.ownedBy"}}</span>
			<button type="button" class="bastionland-npc-header__owner-name" data-action="openOwner" data-uuid="{{ownedBy.uuid}}" data-tooltip="{{localize 'bastionland.npc.openOwner'}}">{{ownedBy.name}}</button>
		</p>
		{{/if}}
	</div>
	{{#if scales}}
	{{!-- An NPC's Scale in a column of its own to the right; a Structure has none. --}}
	<div class="bastionland-npc-header__scale">
		<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.npc.scale"}}</h2>
		<ul class="bastionland-choices">
			{{#each scales}}
			<li>
				<button type="button" class="bastionland-choice bastionland-pill{{#if active}} is-active{{/if}}" data-action="setScale" data-scale="{{key}}" data-tooltip="{{hint}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}}</button>
			</li>
			{{/each}}
		</ul>
	</div>
	{{/if}}
</header>
