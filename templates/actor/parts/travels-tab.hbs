{{!-- The Travels page, shared by the Knight sheet and the Squire's: the Company's places on a Realm. --}}
{{#if tabs.travels}}
<div class="tab {{tabs.travels.cssClass}}" data-group="primary" data-tab="travels">
	<section class="bastionland-block bastionland-travels-tab">
		<header class="bastionland-travels-tab__head">
			<h2 class="bastionland-heading">{{localize "bastionland.sheet.travels"}}</h2>
			<button type="button" data-action="openPlaces"><i class="fa-solid fa-up-right-from-square" inert></i> {{localize "bastionland.travels.openPlaces"}}</button>
		</header>
		{{#with travels}}{{> "bastionland.travels-list"}}{{/with}}
	</section>
</div>
{{/if}}
