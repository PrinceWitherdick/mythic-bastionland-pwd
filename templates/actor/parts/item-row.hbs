<li class="bastionland-item draggable" data-item-id="{{id}}">
	<div class="bastionland-item__line">
		{{#if equippable}}
		<button type="button" class="bastionland-item__equip{{#if equipped}} is-active{{/if}}" data-action="toggleEquipped" data-tooltip="{{equipLabel}}" aria-label="{{equipLabel}}" aria-pressed="{{#if equipped}}true{{else}}false{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>
			<i class="fa-solid {{equipIcon}}" inert></i>
		</button>
		{{/if}}
		<button type="button" class="bastionland-item__name" data-action="postItem" data-tooltip="{{localize 'bastionland.sheet.toChat'}}" data-viewable><span class="bastionland-item__title"><span class="bastionland-item__head">{{nameHead}}</span>{{nameSep}}</span>{{#if nameRest}} <span class="bastionland-item__gloss">{{nameRest}}</span>{{/if}}</button>
		{{#if tags.length}}
		<span class="bastionland-item__tags">({{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}})</span>
		{{/if}}
		{{#if @root.editable}}
		<span class="bastionland-item__controls">
			{{#if remedyLabel}}
			<button type="button" class="bastionland-icon" data-action="useRemedy" data-tooltip="{{remedyLabel}}" aria-label="{{remedyLabel}}">
				<i class="fa-solid fa-flask" inert></i>
			</button>
			{{/if}}
			{{#if pending}}
			<button type="button" class="bastionland-icon" data-action="settleScar" data-tooltip="{{localize 'bastionland.scarRoll.settle'}}" aria-label="{{localize 'bastionland.scarRoll.settle'}}">
				<i class="fa-solid fa-hand-holding-medical" inert></i>
			</button>
			{{/if}}
			<button type="button" class="bastionland-icon" data-action="editItem" data-tooltip="{{localize 'bastionland.sheet.edit'}}" aria-label="{{localize 'bastionland.sheet.edit'}}">
				<i class="fa-solid fa-pen" inert></i>
			</button>
			<button type="button" class="bastionland-icon" data-action="deleteItem" data-tooltip="{{localize 'bastionland.sheet.delete'}}" aria-label="{{localize 'bastionland.sheet.delete'}}">
				<i class="fa-solid fa-trash" inert></i>
			</button>
		</span>
		{{/if}}
	</div>
	{{#with bookTable}}
	<p class="bastionland-item__book-table"><button type="button" class="bastionland-item__book-roll" data-action="openKnightTable" data-viewable data-tooltip="{{tooltip}}">{{label}} <i class="fa-solid fa-dice-d6" inert></i></button>{{#each results}} {{column}}: <strong>{{entry}}</strong>{{#unless @last}} ·{{/unless}}{{/each}}</p>
	{{/with}}
	{{#if description}}
	<div class="bastionland-item__description">{{{description}}}</div>
	{{/if}}
</li>
