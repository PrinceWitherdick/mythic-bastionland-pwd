{{!-- The steed ridden: what it is, what it tramples with, and the taking or letting go of one. --}}
				<section class="bastionland-block">
					<h2 class="bastionland-heading">{{localize "bastionland.steed.label"}}</h2>
					{{#if steed}}
					<div class="bastionland-steed">
						<img class="bastionland-steed__img" src="{{steed.img}}" alt="">
						<div class="bastionland-steed__text">
							<span class="bastionland-steed__title">
								<button type="button" class="bastionland-item__name" data-action="openSteed">{{steed.name}}</button>
								{{#if steed.renamable}}
								<button type="button" class="bastionland-icon" data-action="renameSteed" data-tooltip="{{localize 'bastionland.steed.rename'}}" aria-label="{{localize 'bastionland.steed.rename'}}">
									<i class="fa-solid fa-pen" inert></i>
								</button>
								{{/if}}
							</span>
							{{#if (or steed.breed steed.trample)}}
							<span class="bastionland-item__tags">{{#if steed.breed}}<span>{{steed.breed}}</span>{{/if}}{{#if steed.trample}}<span>{{steed.trample}}</span>{{/if}}</span>
							{{/if}}
						</div>
						{{#if editable}}
						<button type="button" class="bastionland-icon" data-action="clearSteed" data-tooltip="{{localize 'bastionland.steed.clear'}}" aria-label="{{localize 'bastionland.steed.clear'}}">
							<i class="fa-solid fa-xmark" inert></i>
						</button>
						{{/if}}
					</div>
					{{else}}
					<p class="bastionland-empty">{{localize "bastionland.steed.empty"}}</p>
					{{#if editable}}
					<div class="bastionland-adds">
						<button type="button" class="bastionland-button" data-action="takeSteed"><i class="fa-solid fa-horse" inert></i> {{localize "bastionland.steed.take"}}</button>
					</div>
					{{/if}}
					{{/if}}
				</section>

