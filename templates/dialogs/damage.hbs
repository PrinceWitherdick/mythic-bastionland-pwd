<div class="bastionland-dialog__body">
	<div class="form-group">
		<label for="bastionland-damage-amount">{{localize "bastionland.damage.amount"}}</label>
		<div class="form-fields">
			<input id="bastionland-damage-amount" type="number" name="damage" value="{{damage}}" placeholder="0" min="0" step="1" autofocus>
		</div>
		<p class="hint">{{localize "bastionland.damage.amountHint"}}</p>
	</div>

	<div class="form-group">
		<label for="bastionland-damage-armour">{{localize "bastionland.damage.armour"}}</label>
		<div class="form-fields">
			<input id="bastionland-damage-armour" type="number" name="armour" value="{{armour}}" min="0" step="1">
		</div>
	</div>

	{{#if situational.length}}
	<fieldset>
		<legend>{{localize "bastionland.damage.situational"}}</legend>
		{{#each situational}}
		<label class="bastionland-check">
			<input type="checkbox" data-situational="{{id}}" {{checked checked}}>
			<span class="bastionland-check__label">{{label}}</span>
		</label>
		{{/each}}
		<p class="hint">{{localize "bastionland.damage.situationalHint"}}</p>
	</fieldset>
	{{/if}}

	<label class="bastionland-check">
		<input type="checkbox" name="ignoreArmour" {{checked ignoreArmour}}>
		<span class="bastionland-check__label">{{localize "bastionland.damage.ignoreArmour"}}</span>
	</label>

	{{#if character}}
	{{#if offerCover}}
	<label class="bastionland-check">
		<input type="checkbox" name="cover">
		<span class="bastionland-check__label">{{localize "bastionland.damage.cover"}}</span>
	</label>
	{{/if}}

	{{!-- A buckler doesn't make a shieldwall (p10), so a target bearing only one can't count one.
	      Otherwise the wall they stand in on the map ticks it, and its tooltip says why or why not. --}}
	<label class="bastionland-check" data-tooltip="{{#if buckler}}{{localize 'bastionland.damage.bucklerOnly'}}{{else if shieldwall}}{{shieldwall.tip}}{{else}}{{localize 'bastionland.damage.shieldwallHint'}}{{/if}}">
		<input type="checkbox" name="shieldwall" {{disabled buckler}} {{checked shieldwall.checked}}>
		<span class="bastionland-check__label">{{localize "bastionland.damage.shieldwall"}}</span>
	</label>

	<label class="bastionland-check">
		<input type="checkbox" name="exposed" {{checked exposed}}>
		<span class="bastionland-check__label">{{localize "bastionland.damage.exposed"}}</span>
	</label>
	{{/if}}

	{{#each requirements}}
	<label class="bastionland-check">
		<input type="checkbox" name="harm-{{key}}" {{checked checked}}>
		<span class="bastionland-check__label">{{label}}</span>
	</label>
	<p class="hint">{{hint}}</p>
	{{/each}}
</div>
