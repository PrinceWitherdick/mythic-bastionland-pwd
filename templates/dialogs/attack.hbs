<div class="bastionland-dialog__body">
	{{#if duel}}
	<label class="bastionland-check" data-tooltip="{{localize 'bastionland.duel.attackHint'}}">
		<input type="checkbox" name="duel" checked>
		<span class="bastionland-check__label">{{duel}}</span>
	</label>
	{{/if}}

	{{#if marks}}
	<ul class="bastionland-dialog__marks">
		{{#each marks}}
		<li>{{this}}</li>
		{{/each}}
	</ul>
	{{/if}}

	<fieldset>
		<legend>{{localize "bastionland.attack.weapons"}}</legend>
		{{#each sources}}
		<label class="bastionland-check">
			<input type="checkbox" name="source.{{id}}" {{checked checked}}>
			<span class="bastionland-check__label">{{name}}</span>
			<span class="bastionland-tag">{{tags}}</span>
		</label>
		{{#if specialist}}
		<label class="bastionland-check bastionland-check--nested" data-tooltip="{{localize 'bastionland.attack.specialistHint'}}">
			<input type="checkbox" name="specialist.{{id}}" {{checked specialistChecked}}>
			<span class="bastionland-check__label">{{specialist}}</span>
		</label>
		{{/if}}
		{{else}}
		<p class="hint">{{localize "bastionland.attack.noWeapons"}}</p>
		{{/each}}
		{{#if unavailable}}
		<p class="hint">{{unavailable}}</p>
		{{/if}}
	</fieldset>

	<fieldset>
		<legend>{{localize "bastionland.attack.situation"}}</legend>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.attack.movedHint'}}">
			<input type="checkbox" name="moved" {{checked moved}}>
			<span class="bastionland-check__label">{{localize "bastionland.attack.moved"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.attack.engagedHint'}}">
			<input type="checkbox" name="engaged" {{checked engaged}}>
			<span class="bastionland-check__label">{{localize "bastionland.attack.engaged"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.attack.confinedHint'}}">
			<input type="checkbox" name="confined" {{checked confined}}>
			<span class="bastionland-check__label">{{localize "bastionland.attack.confined"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.attack.mountedHint'}}">
			<input type="checkbox" name="mounted" {{checked mounted}}>
			<span class="bastionland-check__label">{{localize "bastionland.attack.mounted"}}</span>
		</label>
		{{#if charge}}
		{{!-- A steed tramples only enemies on foot (p10), so a charge at riders alone has nothing to add. --}}
		<label class="bastionland-check" data-tooltip="{{#if chargeBarred}}{{chargeBarred}}{{else}}{{localize 'bastionland.attack.chargeHint'}}{{/if}}">
			<input type="checkbox" name="charge" {{#if chargeBarred}}disabled{{else}}{{checked chargeChecked}}{{/if}}>
			<span class="bastionland-check__label">{{charge}}</span>
		</label>
		{{/if}}
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.attack.spearwallHint'}}">
			<input type="checkbox" name="spearwall" {{checked spearwall}}>
			<span class="bastionland-check__label">{{localize "bastionland.attack.spearwall"}}</span>
		</label>
		{{#if exhausted}}
		<p class="hint">{{localize "bastionland.conditions.exhausted.hint"}}</p>
		{{/if}}
		{{#if impaired}}
		<p class="hint">{{localize "bastionland.attack.impaired"}}</p>
		{{/if}}
	</fieldset>

	<ul class="bastionland-dialog__problems" data-wielding-problems hidden></ul>

	{{!-- A foe's weakness the Knights have learned gives every Attack that uses it a die (p188). --}}
	{{#each weaknesses}}
	<label class="bastionland-check" data-tooltip="{{localize 'bastionland.attack.weaknessHint'}}">
		<input type="checkbox" name="weakness.{{index}}" checked>
		<span class="bastionland-check__label">{{label}}</span>
	</label>
	{{/each}}

	<div class="form-group">
		<label for="bastionland-attack-bonus">{{localize "bastionland.attack.bonus"}}</label>
		<div class="form-fields">
			<input id="bastionland-attack-bonus" type="text" name="bonus" placeholder="d8" autocomplete="off">
		</div>
		<p class="hint">{{localize "bastionland.attack.bonusHint"}}</p>
	</div>

	<div class="form-group">
		<label for="bastionland-attack-smite">{{localize "bastionland.feats.smite.name"}}</label>
		<div class="form-fields">
			<select id="bastionland-attack-smite" name="smite" {{disabled smiteDisabled}}>
				<option value="">—</option>
				<option value="d12">{{localize "bastionland.attack.smite"}}</option>
				<option value="blast">{{localize "bastionland.attack.blast"}}</option>
				<option value="mark">{{localize "bastionland.attack.smiteMark"}}</option>
			</select>
		</div>
		<p class="hint">{{localize "bastionland.attack.smiteHint"}}</p>
	</div>

	{{#if warband}}
	{{!-- Ticked when everybody targeted is an individual, rather than a Warband, a swarm or a structure (p11). --}}
	<label class="bastionland-check"{{#if againstIndividualsTip}} data-tooltip="{{againstIndividualsTip}}"{{/if}}>
		<input type="checkbox" name="againstIndividuals" {{checked againstIndividuals}}>
		<span class="bastionland-check__label">{{localize "bastionland.attack.againstIndividuals"}}</span>
	</label>
	<p class="hint">{{localize "bastionland.attack.againstIndividualsHint"}}</p>

	<div class="form-group">
		<label for="bastionland-attack-leader">{{localize "bastionland.attack.leader"}}</label>
		<div class="form-fields">
			<select id="bastionland-attack-leader" name="leader">
				<option value="">{{localize "bastionland.attack.leaderNone"}}</option>
				{{#each leaders}}
				<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
				{{/each}}
			</select>
		</div>
		<p class="hint">{{localize "bastionland.attack.leaderHint"}}</p>
	</div>
	{{/if}}
</div>
