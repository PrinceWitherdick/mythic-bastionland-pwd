{{!-- The box a steed is named in: value, if it has a name already. --}}
<div class="form-group">
	<label for="bastionland-steed-name">{{localize "bastionland.steed.nameLabel"}}</label>
	<div class="form-fields">
		<input id="bastionland-steed-name" type="text" name="name" value="{{value}}" placeholder="{{localize 'bastionland.steed.namePlaceholder'}}" autocomplete="off">
	</div>
</div>
