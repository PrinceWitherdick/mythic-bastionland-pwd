<div class="bastionland-dialog__body bastionland-keep-realm">
	<p>{{localize "bastionland.realm.keep.intro"}}</p>

	<p class="bastionland-keep-realm__tally" data-keep-tally>{{tally}}</p>

	<p class="bastionland-keep-realm__seed">
		{{localize "bastionland.realm.dialog.seed"}} <code data-keep-seed>{{seed}}</code>
	</p>

	<button type="button" class="bastionland-keep-realm__again" data-keep-again>
		<i class="fa-solid fa-dice" inert></i>
		<span>{{localize "bastionland.realm.keep.again"}}</span>
	</button>

	{{#if myths}}
	<button type="button" class="bastionland-keep-realm__again bastionland-keep-realm__myths" data-keep-myths>
		<i class="fa-solid fa-dragon" inert></i>
		<span>{{localize "bastionland.realm.keep.myths"}}</span>
	</button>
	{{/if}}

	<p class="hint">{{localize "bastionland.realm.keep.hint"}}</p>
</div>
