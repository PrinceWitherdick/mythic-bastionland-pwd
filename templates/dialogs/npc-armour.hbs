<div class="bastionland-dialog__body">
	<div class="form-group">
		<label for="bastionland-npc-armour-note">{{localize "bastionland.npc.armourEdit.note"}}</label>
		<div class="form-fields">
			<input id="bastionland-npc-armour-note" type="text" name="note" value="{{note}}" placeholder="{{placeholder}}" autocomplete="off" autofocus>
		</div>
	</div>
	<div class="form-group">
		<label for="bastionland-npc-armour-value">{{localize "bastionland.sheet.armour"}}</label>
		<div class="form-fields">
			<input id="bastionland-npc-armour-value" type="number" name="armour" value="{{armour}}" min="0" step="1">
		</div>
	</div>
</div>
