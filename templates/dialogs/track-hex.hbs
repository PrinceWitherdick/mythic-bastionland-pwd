<div class="bastionland-dialog__body">
	{{!-- A hex to put on the GM Toolkit's Custom list, by its column and row, for when the Realm isn't on the map to click. --}}
	<p class="hint">{{localize "bastionland.gmToolkit.places.track.askHint"}}</p>
	<div class="form-group">
		<label for="bastionland-track-col">{{localize "bastionland.gmToolkit.places.track.column"}}</label>
		<div class="form-fields">
			<input id="bastionland-track-col" type="number" name="col" min="1" max="{{cols}}" step="1" required autofocus>
		</div>
	</div>

	<div class="form-group">
		<label for="bastionland-track-row">{{localize "bastionland.gmToolkit.places.track.row"}}</label>
		<div class="form-fields">
			<input id="bastionland-track-row" type="number" name="row" min="1" max="{{rows}}" step="1" required>
		</div>
	</div>
</div>
