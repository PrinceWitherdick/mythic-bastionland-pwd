<div class="bastionland-dialog__body">
	<p>{{intro}}</p>
	<fieldset>
		<legend>{{localize "bastionland.time.company"}}</legend>
		{{#each members}}
		<div class="bastionland-company__member">
			<label class="bastionland-check">
				<input type="checkbox" name="include-{{index}}" {{checked included}}>
				<span class="bastionland-check__label">{{name}}</span>
			</label>
			{{#if ../pursuits.length}}
			<select name="pursuit-{{index}}" aria-label="{{localize 'bastionland.time.pursuit'}}">
				<option value="">—</option>
				{{#each ../pursuits}}
				<option value="{{key}}">{{label}}</option>
				{{/each}}
			</select>
			{{/if}}
			{{!-- What a Service or Courtesy made (p17), offered only once the pursuit picked makes something. --}}
			{{#if ../makings.length}}
			<select name="making-{{index}}" aria-label="{{localize 'bastionland.time.pursuitMakes.label'}}" data-making hidden>
				<option value="">{{localize "bastionland.time.pursuitMakes.later"}}</option>
				{{#each ../makings}}
				<option value="{{value}}" data-pursuit="{{pursuit}}">{{label}}</option>
				{{/each}}
			</select>
			{{/if}}
			{{#if older}}
			<label class="bastionland-check bastionland-company__older" data-tooltip="{{localize 'bastionland.time.aging.growsHint'}}">
				<input type="checkbox" name="older-{{index}}" checked>
				<span class="bastionland-check__label">{{older}}</span>
			</label>
			{{/if}}
		</div>
		{{else}}
		<p class="hint">{{localize "bastionland.time.noCompany"}}</p>
		{{/each}}
	</fieldset>
	{{#each pursuits}}
	<p class="hint"><strong>{{label}}</strong>: {{hint}}</p>
	{{/each}}
</div>
