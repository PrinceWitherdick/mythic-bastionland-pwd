<div class="bastionland-dialog__body bastionland-timeline-entry">
	{{!-- A Timeline entry, new or edited (promptTimelineEntry in module/apps/timeline-ui.js): when, a tag on one somebody typed, a title, a place and what happened. --}}
	<div class="form-group">
		<label for="bastionland-timeline-when">{{localize "bastionland.timeline.entry.when"}}</label>
		<div class="form-fields">
			<select id="bastionland-timeline-when" name="season">
				{{#each dates}}
				<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
				{{/each}}
			</select>
		</div>
	</div>
	{{#if tags}}
	{{!-- One tag: none, a kind the game records (the entry then reads as that kind), or one of the table's own, kept for the whole world. --}}
	<fieldset class="bastionland-timeline-entry__tag-set">
		<legend>{{localize "bastionland.timeline.entry.tag"}}</legend>
		<div class="bastionland-timeline-entry__tags">
			{{#each tags}}{{> "bastionland.timeline-entry-tag"}}{{/each}}
		</div>
		{{#if canMakeTags}}
		<details class="bastionland-timeline-entry__new-tag">
			<summary class="bastionland-button"><i class="fa-solid fa-plus" inert></i> {{localize "bastionland.timeline.entry.newTag"}}</summary>
			<div class="bastionland-timeline-entry__new-tag-fields">
				<input type="text" data-timeline-tag-name maxlength="{{tagNameMax}}" autocomplete="off" aria-label="{{localize "bastionland.timeline.entry.tagName"}}" placeholder="{{localize "bastionland.timeline.entry.tagNamePlaceholder"}}">
				<input type="color" data-timeline-tag-colour value="{{tagColour}}" aria-label="{{localize "bastionland.timeline.entry.tagColour"}}" data-tooltip="{{localize "bastionland.timeline.entry.tagColour"}}">
				<button type="button" class="bastionland-button" data-timeline-tag-add>{{localize "bastionland.timeline.entry.tagAdd"}}</button>
			</div>
		</details>
		{{/if}}
	</fieldset>
	{{/if}}
	<div class="form-group">
		<label for="bastionland-timeline-title">{{localize "bastionland.timeline.entry.title"}}</label>
		<div class="form-fields">
			<input id="bastionland-timeline-title" type="text" name="title" value="{{title}}" autocomplete="off" autofocus>
		</div>
	</div>
	{{!-- Type a place, or drop a document on the field to make it a link; typing takes the link off again. --}}
	<div class="form-group">
		<label for="bastionland-timeline-place">{{localize "bastionland.timeline.entry.place"}}</label>
		<div class="form-fields bastionland-timeline-entry__place{{#if placeUuid}} is-linked{{/if}}">
			<input id="bastionland-timeline-place" type="text" name="place" value="{{place}}" autocomplete="off" list="bastionland-timeline-places">
			<input type="hidden" name="placeUuid" value="{{placeUuid}}">
			<span class="bastionland-timeline-entry__linked" data-tooltip="{{localize "bastionland.timeline.entry.linkedTooltip"}}"><i class="fa-solid fa-link" inert></i> {{localize "bastionland.timeline.entry.linked"}}</span>
		</div>
		<datalist id="bastionland-timeline-places">
			{{#each places}}<option value="{{this}}"></option>{{/each}}
		</datalist>
		<p class="hint">{{localize "bastionland.timeline.entry.placeHint"}}</p>
	</div>
	<div class="form-group stacked">
		<label for="bastionland-timeline-body">{{localize "bastionland.timeline.entry.body"}}</label>
		<textarea id="bastionland-timeline-body" name="body" rows="5">{{body}}</textarea>
		<p class="hint">{{localize "bastionland.timeline.entry.bodyHint"}}</p>
	</div>
</div>
