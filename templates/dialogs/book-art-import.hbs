<div class="bastionland-dialog__body">
	<p>{{localize "bastionland.bookArt.intro" pages=pages}}</p>

	<div class="form-group stacked">
		<label for="bastionland-book-art-pdf">{{localize "bastionland.bookArt.choose"}}</label>
		<div class="form-fields">
			<input id="bastionland-book-art-pdf" type="file" name="pdf" accept="application/pdf,.pdf" required>
		</div>
		<p class="hint">{{localize "bastionland.bookArt.chooseHint"}}</p>
	</div>

	<p class="hint">{{localize "bastionland.bookArt.outputHint" root=root}}</p>
</div>
