<div class="bastionland-dialog__body bastionland-rail-dialog" data-rail>
	{{!-- New Realm, laid out as a rail of pages down the left like Stonetop's welcome
	      window: the rail shows one page at a time and the banner names it. Pages are
	      only hidden, never re-rendered, so what's filled in on one is kept. See
	      module/apps/dialog-rail.js. --}}
	<nav class="bastionland-rail-dialog__rail" aria-label="{{localize "bastionland.realm.dialog.title"}}">
		<ol>
			{{#each pages}}
			<li>
				<button type="button" class="bastionland-rail-dialog__tab{{#if @first}} is-active{{/if}}" data-rail-tab="{{key}}" data-rail-icon="{{icon}}"{{#if @first}} aria-current="true"{{/if}}>
					<i class="fa-solid {{icon}}" inert></i>
					<span>{{label}}</span>
				</button>
			</li>
			{{/each}}
		</ol>
	</nav>

	<div class="bastionland-rail-dialog__main">
		<header class="bastionland-rail-dialog__banner">
			<i class="fa-solid {{firstPage.icon}}" inert data-rail-banner-icon></i>
			<div>
				<span class="bastionland-rail-dialog__title" data-rail-banner-title>{{firstPage.label}}</span>
				<span class="bastionland-rail-dialog__sub">{{making}}</span>
			</div>
		</header>

		<section class="bastionland-rail-dialog__page" data-rail-page="realm">
			<p>{{#if traced}}{{localize "bastionland.realm.dialog.tracedIntro"}}{{else if draw}}{{localize "bastionland.realm.dialog.drawIntro"}}{{else}}{{localize "bastionland.realm.dialog.intro"}}{{/if}}</p>

			<div class="form-group">
				<label for="bastionland-realm-name">{{localize "bastionland.realm.dialog.name"}}</label>
				<div class="form-fields">
					<input id="bastionland-realm-name" type="text" name="name" value="{{name}}">
				</div>
			</div>

			{{#unless draw}}
			<div class="form-group">
				<label for="bastionland-realm-seed">{{localize "bastionland.realm.dialog.seed"}}</label>
				<div class="form-fields">
					<input id="bastionland-realm-seed" type="text" name="seed" value="{{seed}}" spellcheck="false" autocomplete="off">
				</div>
				<p class="hint">{{localize "bastionland.realm.dialog.seedHint"}}</p>
			</div>
			{{/unless}}

			<p class="hint">{{localize "bastionland.realm.dialog.secretHint"}}</p>
		</section>

		{{#if traced}}
		<section class="bastionland-rail-dialog__page" data-rail-page="picture" hidden>
			<p>{{localize "bastionland.realm.picture.intro"}}</p>
			{{> "bastionland.realm-picture"}}
			{{!-- Shown once the picture has loaded, when it's far from a typical Realm's shape (module/apps/map-size-fields.js). --}}
			<p class="hint" data-map-shape="wide" hidden>{{localize "bastionland.realm.picture.shape.wide"}}</p>
			<p class="hint" data-map-shape="tall" hidden>{{localize "bastionland.realm.picture.shape.tall"}}</p>
			<p class="hint">{{localize "bastionland.realm.picture.lineUpHint"}}</p>
		</section>
		{{/if}}

		<section class="bastionland-rail-dialog__page" data-rail-page="setup" hidden>
			{{#if traced}}
			{{!-- A map of the GM's own sets its own size, with no rule ignored: the hexes they count on it, or as many as its shape takes (module/apps/map-size-fields.js). --}}
			<p class="hint" data-map-mode="drawn">{{localize "bastionland.realm.picture.drawnSizeIntro" side=sizeLimits.side hexes=sizeLimits.hexes}}</p>
			<p class="hint" data-map-mode="bare" hidden>{{localize "bastionland.realm.picture.bare.sizeIntro" side=sizeLimits.side hexes=sizeLimits.hexes}}</p>
			{{else}}
			{{#if draw}}<p class="hint">{{localize "bastionland.realm.setup.sizeIntro"}}</p>{{/if}}

			{{!-- Ignoring the rules only unlocks the numbers; leaving a part off to draw by hand keeps to them, so the parts' own intro sits just above the parts. --}}
			<label class="bastionland-check">
				<input type="checkbox" name="setup.ignoreRules" data-setup-ignore>
				<span class="bastionland-check__label">{{localize "bastionland.realm.setup.ignoreRules"}}</span>
			</label>
			<p class="hint">{{localize "bastionland.realm.setup.ignoreRulesHint"}}</p>

			{{#unless draw}}<p class="hint">{{localize "bastionland.realm.setup.intro"}}</p>{{/unless}}
			{{/if}}

			<div class="bastionland-realm-setup__parts">
				{{#each setupParts}}
				<div class="bastionland-realm-setup__part" data-setup-part="{{key}}">
					{{#if rollable}}
					<label class="bastionland-check bastionland-realm-setup__name">
						<input type="checkbox" name="setup.roll.{{key}}" checked data-setup-roll>
						<span class="bastionland-check__label">{{label}}</span>
					</label>
					{{else}}
					<span class="bastionland-realm-setup__name">{{label}}</span>
					{{/if}}
					{{!-- The numbers and the note read as one line, the note wrapping under them only where there's no room. --}}
					<div class="bastionland-realm-setup__body">
						{{#if fields.length}}
						<div class="bastionland-realm-setup__numbers">
							{{#each fields}}
							<label class="bastionland-realm-setup__field{{#if tight}} is-tight{{/if}}">
								{{#if label}}<span>{{label}}</span>{{/if}}
								<input type="number" name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="1" disabled data-setup-number data-book="{{value}}"{{#unless label}} aria-label="{{../label}}"{{/unless}}>
								{{#if after}}<span>{{after}}</span>{{/if}}
							</label>
							{{/each}}
							{{#if note}}<span class="bastionland-realm-setup__note">{{note}}</span>{{/if}}
						</div>
						{{else if note}}
						<p class="bastionland-realm-setup__note">{{note}}</p>
						{{/if}}
						{{!-- Shown only once the rules are ignored: until then there's nothing to fill in (module/apps/realm-setup-fields.js). --}}
						{{#if more.length}}
						<div class="bastionland-realm-setup__more" data-setup-more hidden>
							<p class="bastionland-realm-setup__note">{{moreNote}}</p>
							<div class="bastionland-realm-setup__types">
								{{#each more}}
								<label class="bastionland-realm-setup__field">
									<span>{{label}}</span>
									<input type="number" name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="1" placeholder="{{placeholder}}" disabled data-setup-number data-book="{{value}}">
								</label>
								{{/each}}
							</div>
						</div>
						{{/if}}
					</div>
				</div>
				{{/each}}
			</div>

			{{#if traced}}
			{{!-- The Realm's hexes laid over the GM's map, drawn in the picture's own pixels. The paths are filled in as the picture loads and the numbers change. --}}
			<div class="bastionland-map-size">
				<figure class="bastionland-map-size__preview" data-map-size-preview hidden>
					<img alt="" data-map-size-picture>
					<svg class="bastionland-map-size__hexes" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-map-size-hexes>
						<path class="bastionland-map-size__outside" data-map-size-outside></path>
						<path class="bastionland-map-size__halo" data-map-size-halo></path>
						<path class="bastionland-map-size__lines" data-map-size-lines></path>
					</svg>
					{{!-- Over the whole map: clicked, it opens larger in a window of its own, where the size can be set too (module/apps/map-size-window.js). --}}
					<button type="button" class="bastionland-map-size__enlarge" data-map-size-enlarge aria-label="{{localize "bastionland.realm.picture.sizeWindow.open"}}" data-tooltip="{{localize "bastionland.realm.picture.sizeWindow.open"}}"><i class="fa-solid fa-expand" inert></i></button>
				</figure>
				{{!-- More hexes or fewer in one click, the map's shape kept. The count's {cols}, {rows} and {hexes} are filled in as the size changes. --}}
				<div class="bastionland-map-size__step" data-map-size-step hidden>
					<button type="button" data-map-size-fewer><i class="fa-solid fa-minus" inert></i> {{localize "bastionland.realm.picture.step.fewer"}}</button>
					<span class="bastionland-map-size__count" data-map-size-count data-format="{{localize "bastionland.realm.picture.step.count"}}"></span>
					<button type="button" data-map-size-more><i class="fa-solid fa-plus" inert></i> {{localize "bastionland.realm.picture.step.more"}}</button>
					<button type="button" class="bastionland-map-size__larger" data-map-size-enlarge aria-label="{{localize "bastionland.realm.picture.sizeWindow.open"}}" data-tooltip="{{localize "bastionland.realm.picture.sizeWindow.open"}}"><i class="fa-solid fa-expand" inert></i></button>
				</div>
				<p class="hint" data-map-mode="drawn">{{localize "bastionland.realm.picture.drawnPreview"}}</p>
				<p class="hint" data-map-mode="bare" hidden>{{localize "bastionland.realm.picture.bare.preview"}}</p>
				<p class="hint" data-map-size-waiting>{{localize "bastionland.realm.picture.bare.noPicture"}}</p>
				<p class="hint" data-map-size-broken hidden>{{localize "bastionland.realm.picture.bare.unreadable"}}</p>
			</div>
			{{/if}}
		</section>

		{{!-- A Realm drawn by hand has no hexes to stand in yet: its Company is chosen on the last page of Creating a Realm. --}}
		{{#unless draw}}
		<section class="bastionland-rail-dialog__page" data-rail-page="company" hidden>
			<label class="bastionland-check">
				<input type="checkbox" name="placeCompany" checked>
				<span class="bastionland-check__label">{{localize "bastionland.company.place"}}</span>
			</label>

			<div class="form-group">
				<label for="bastionland-company-start">{{localize "bastionland.company.start"}}</label>
				<div class="form-fields">
					<select id="bastionland-company-start" name="start">
						{{#each starts}}
						<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
						{{/each}}
					</select>
				</div>
				<p class="hint" data-company-hint>{{startHint}}</p>
			</div>

			{{> "bastionland.company-picture"}}

			<p class="hint">{{localize "bastionland.company.tokenHint"}}</p>
		</section>
		{{/unless}}
	</div>
</div>
