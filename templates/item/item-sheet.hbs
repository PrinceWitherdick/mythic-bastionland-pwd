<div class="bastionland-page bastionland-page--item">
	<header class="bastionland-item-header">
		{{#if hasPicture}}
		<img class="bastionland-item-header__img" src="{{item.img}}" alt="" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
		{{/if}}
		<div class="bastionland-item-header__text">
			<input class="bastionland-item-header__name" type="text" name="name" value="{{item.name}}" aria-label="{{typeLabel}}" autocomplete="off">
			<p class="bastionland-item-header__type">{{typeLabel}}</p>
		</div>
	</header>

	{{#if isWeapon}}
	<div class="form-group">
		<label for="{{rootId}}-damage">{{localize "bastionland.item.damage"}}</label>
		<div class="form-fields">
			<input id="{{rootId}}-damage" type="text" name="system.damage" value="{{system.damage}}" autocomplete="off">
		</div>
		<p class="hint">{{localize "bastionland.item.damageHint"}}</p>
	</div>
	<fieldset class="bastionland-qualities">
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.heftyHint'}}">
			<input type="checkbox" name="system.hefty" {{checked system.hefty}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.hefty"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.longHint'}}">
			<input type="checkbox" name="system.long" {{checked system.long}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.long"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.slowHint'}}">
			<input type="checkbox" name="system.slow" {{checked system.slow}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.slow"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.heftyMountedHint'}}">
			<input type="checkbox" name="system.heftyMounted" {{checked system.heftyMounted}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.heftyMounted"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.rangedHint'}}">
			<input type="checkbox" name="system.ranged" {{checked system.ranged}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.ranged"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.blastHint'}}">
			<input type="checkbox" name="system.blast" {{checked system.blast}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.blast"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.ignoresArmourHint'}}">
			<input type="checkbox" name="system.ignoresArmour" {{checked system.ignoresArmour}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.ignoresArmour"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.trampleHint'}}">
			<input type="checkbox" name="system.trample" {{checked system.trample}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.trample"}}</span>
		</label>
	</fieldset>
	<div class="form-group bastionland-item-specialist">
		<label for="{{rootId}}-specialist">{{localize "bastionland.item.specialist"}}</label>
		<div class="form-fields">
			<select id="{{rootId}}-specialist" name="system.specialist.die">
				{{selectOptions specialistOptions selected=system.specialist.die}}
			</select>
			<input type="text" name="system.specialist.situation" value="{{system.specialist.situation}}" placeholder="{{localize 'bastionland.item.specialistPlaceholder'}}" aria-label="{{localize 'bastionland.item.specialistSituation'}}" autocomplete="off">
		</div>
		<p class="hint">{{localize "bastionland.item.specialistHint"}}</p>
	</div>
	<fieldset class="bastionland-item-alternate">
		<legend>{{localize "bastionland.item.alternate"}}</legend>
		<div class="form-group">
			<label for="{{rootId}}-alternate-label">{{localize "bastionland.item.alternateLabel"}}</label>
			<div class="form-fields">
				<input id="{{rootId}}-alternate-label" type="text" name="system.alternate.label" value="{{system.alternate.label}}" placeholder="{{localize 'bastionland.item.alternatePlaceholder'}}" autocomplete="off">
				<input type="text" name="system.alternate.damage" value="{{system.alternate.damage}}" placeholder="d10" aria-label="{{localize 'bastionland.item.damage'}}" autocomplete="off">
			</div>
		</div>
		<div class="bastionland-qualities">
			{{#each alternateQualities}}
			<label class="bastionland-check" data-tooltip="{{hint}}">
				<input type="checkbox" name="system.alternate.{{key}}" {{checked checked}}>
				<span class="bastionland-check__label">{{label}}</span>
			</label>
			{{/each}}
		</div>
		<p class="hint">{{localize "bastionland.item.alternateHint"}}</p>
	</fieldset>
	{{#if insteadOf}}
	{{!-- Attacks printed with "or" between them, of which an Attack uses only one. --}}
	<div class="form-group">
		<label for="{{rootId}}-instead-of">{{localize "bastionland.item.insteadOf"}}</label>
		<div class="form-fields">
			<select id="{{rootId}}-instead-of" name="insteadOf">
				{{selectOptions insteadOf.options selected=insteadOf.selected}}
			</select>
		</div>
		<p class="hint">{{localize "bastionland.item.insteadOfHint"}}</p>
	</div>
	{{/if}}
	<fieldset class="bastionland-qualities">
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.usedUpHint'}}">
			<input type="checkbox" name="system.usedUp" {{checked system.usedUp}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.usedUp"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.woodenHint'}}">
			<input type="checkbox" name="system.wooden" {{checked system.wooden}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.wooden"}}</span>
		</label>
	</fieldset>
	{{/if}}

	{{#if isGear}}
	<div class="form-group">
		<label for="{{rootId}}-remedy">{{localize "bastionland.item.remedy"}}</label>
		<div class="form-fields">
			<select id="{{rootId}}-remedy" name="system.remedy">
				{{selectOptions remedyOptions selected=system.remedy}}
			</select>
		</div>
		<p class="hint">{{localize "bastionland.item.remedyHint"}}</p>
	</div>
	<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.poisonHint'}}">
		<input type="checkbox" name="system.poison" {{checked system.poison}}>
		<span class="bastionland-check__label">{{localize "bastionland.item.poison"}}</span>
	</label>
	{{/if}}

	{{#if isArmour}}
	<div class="form-group">
		<label for="{{rootId}}-kind">{{localize "bastionland.item.kind"}}</label>
		<div class="form-fields">
			<select id="{{rootId}}-kind" name="system.kind">
				{{selectOptions kindOptions selected=system.kind}}
			</select>
		</div>
	</div>
	<div class="form-group">
		<label for="{{rootId}}-armour">{{localize "bastionland.item.armour"}}</label>
		<div class="form-fields">
			<input id="{{rootId}}-armour" type="number" name="system.armour" value="{{system.armour}}" min="0" step="1">
		</div>
	</div>
	<div class="form-group">
		<label for="{{rootId}}-attack-die">{{localize "bastionland.item.attackDie"}}</label>
		<div class="form-fields">
			<input id="{{rootId}}-attack-die" type="text" name="system.damage" value="{{system.damage}}" placeholder="d4" autocomplete="off">
		</div>
		<p class="hint">{{localize "bastionland.item.attackDieHint"}}</p>
	</div>
	<div class="form-group bastionland-item-condition">
		<label for="{{rootId}}-condition">{{localize "bastionland.item.condition"}}</label>
		<div class="form-fields">
			<select id="{{rootId}}-condition" name="system.condition">
				{{selectOptions conditionOptions selected=system.condition}}
			</select>
			<input type="text" name="system.situation" value="{{system.situation}}" placeholder="{{localize 'bastionland.item.situationPlaceholder'}}" aria-label="{{localize 'bastionland.item.situation'}}" autocomplete="off">
		</div>
		<p class="hint">{{localize "bastionland.item.conditionHint"}}</p>
	</div>
	<fieldset class="bastionland-qualities">
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.holdsHint'}}">
			<input type="checkbox" name="system.holds" {{checked system.holds}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.holds"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.bucklerHint'}}">
			<input type="checkbox" name="system.buckler" {{checked system.buckler}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.buckler"}}</span>
		</label>
		<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.woodenHint'}}">
			<input type="checkbox" name="system.wooden" {{checked system.wooden}}>
			<span class="bastionland-check__label">{{localize "bastionland.item.wooden"}}</span>
		</label>
	</fieldset>
	{{/if}}

	{{#if isPossession}}
	<div class="form-group">
		<label for="{{rootId}}-rarity">{{localize "bastionland.item.rarity"}}</label>
		<div class="form-fields">
			<select id="{{rootId}}-rarity" name="system.rarity">
				{{selectOptions rarityOptions selected=system.rarity}}
			</select>
		</div>
		<p class="hint">{{localize "bastionland.item.rarityHint"}}</p>
	</div>
	{{> "bastionland.item-stock" id="quantity" label="bastionland.item.quantity" maxLabel="bastionland.item.quantityMax" restockLabel="bastionland.item.restock" options=restockOptions hint="bastionland.item.quantityHint"}}
	<label class="bastionland-check" data-tooltip="{{localize 'bastionland.item.brokenHint'}}">
		<input type="checkbox" name="system.broken" {{checked system.broken}}>
		<span class="bastionland-check__label">{{localize "bastionland.item.broken"}}</span>
	</label>
	{{/if}}

	{{#if (or isWeapon isArmour)}}
	<label class="bastionland-check">
		<input type="checkbox" name="system.equipped" {{checked system.equipped}}>
		<span class="bastionland-check__label">{{localize "bastionland.item.equipped"}}</span>
	</label>
	{{/if}}

	{{#if isAbility}}
	{{> "bastionland.item-stock" id="uses" label="bastionland.ability.uses" maxLabel="bastionland.ability.usesMax" restockLabel="bastionland.ability.ready" options=abilityCadenceOptions hint="bastionland.ability.usesHint"}}
	{{#if editable}}
	<button type="button" class="bastionland-button" data-action="readUses" data-tooltip="{{localize 'bastionland.ability.readUsesHint'}}"><i class="fa-solid fa-glasses" inert></i> {{localize "bastionland.ability.readUses"}}</button>
	{{/if}}
	<fieldset>
		<legend>{{localize "bastionland.ability.grantsLabel"}}</legend>
		{{#each abilityGrants}}
		<label class="bastionland-check" data-tooltip="{{hint}}">
			<input type="checkbox" name="system.grants.{{key}}" {{checked checked}}>
			<span class="bastionland-check__label">{{label}}</span>
		</label>
		{{/each}}
		<p class="hint">{{localize "bastionland.ability.grantsHint"}}</p>
	</fieldset>
	<div class="form-group">
		<label for="{{rootId}}-lasting">{{localize "bastionland.ability.lastingDie"}}</label>
		<div class="form-fields">
			<select id="{{rootId}}-lasting" name="system.lastingDie">
				{{selectOptions lastingDieOptions selected=system.lastingDie}}
			</select>
		</div>
		<p class="hint">{{localize "bastionland.ability.lastingDieHint"}}</p>
	</div>
	{{/if}}

	{{#if isScar}}
	<div class="form-group">
		<label for="{{rootId}}-roll">{{localize "bastionland.item.scarRoll"}}</label>
		<div class="form-fields">
			<input id="{{rootId}}-roll" type="number" name="system.roll" value="{{system.roll}}" min="1" max="12" step="1">
		</div>
	</div>
	{{#if byRevenge}}
	<div class="form-group">
		<label for="{{rootId}}-foe">{{localize "bastionland.revenge.foe"}}</label>
		<div class="form-fields">
			<input id="{{rootId}}-foe" type="text" name="system.foeName" value="{{system.foeName}}">
		</div>
		<p class="hint">{{localize "bastionland.revenge.foeHint"}}</p>
	</div>
	{{/if}}
	{{/if}}

	<section class="bastionland-item-description">
		<h2 class="bastionland-heading bastionland-heading--small">{{localize "bastionland.item.description"}}</h2>
		{{#if editable}}
		{{!-- An item that hasn't been added yet has no uuid to enrich links against. --}}
		<prose-mirror name="system.description" value="{{system.description}}" {{#if item.uuid}}document-uuid="{{item.uuid}}"{{/if}} toggled="true">{{{enrichedDescription}}}</prose-mirror>
		{{else}}
		<div class="editor-content">{{{enrichedDescription}}}</div>
		{{/if}}
	</section>

	{{#if isNew}}
	{{!-- Nothing has been written to the actor yet: saving is what adds the item. --}}
	<footer class="bastionland-item-footer">
		<button type="button" class="bastionland-button" data-action="close">
			<i class="fa-solid fa-xmark" inert></i> {{localize "bastionland.item.cancel"}}
		</button>
		<button type="submit" class="bastionland-button">
			<i class="fa-solid fa-check" inert></i> {{localize "bastionland.item.save"}}
		</button>
	</footer>
	{{else if editable}}
	{{!-- An item the actor already carries writes every change as it's made, so
	      Save only shuts the window; Delete is here rather than on the row. --}}
	<footer class="bastionland-item-footer">
		<button type="button" class="bastionland-button bastionland-item-footer__delete" data-action="deleteItem">
			<i class="fa-solid fa-trash" inert></i> {{localize "bastionland.sheet.delete"}}
		</button>
		<button type="button" class="bastionland-button" data-action="saveAndClose">
			<i class="fa-solid fa-check" inert></i> {{localize "bastionland.item.save"}}
		</button>
	</footer>
	{{/if}}
</div>
