{
  "$schema": "https://json.schemastore.org/foundryvtt-system-manifest.json",
  "id": "mythic-bastionland-pwd",
  "title": "Mythic Bastionland",
  "description": "<p>An unofficial system for playing Mythic Bastionland, the game of Knights, Seers and Myths by Chris McDowall, made with his permission. It is not an official Bastionland Press product.</p><p>Knight, NPC, Domain and Structure sheets, the book's Attack, Damage and Scar rules, a Realm map rolled or drawn the book's way with its travel and exploration rules beside it, and a GM Toolkit for Myths, Omens, Places and the calendar.</p><p>Mythic Bastionland, its text, art and trade dress are &copy; Chris McDowall, Bastionland Press. All rights reserved.</p>",
  "version": "0.9.2",
  "compatibility": {
    "minimum": "13",
    "verified": "14.363"
  },
  "authors": [
    {
      "name": "PrinceWitherdick"
    }
  ],
  "url": "https://github.com/PrinceWitherdick/mythic-bastionland-pwd",
  "manifest": "https://github.com/PrinceWitherdick/mythic-bastionland-pwd/releases/latest/download/system.json",
  "download": "https://github.com/PrinceWitherdick/mythic-bastionland-pwd/releases/download/0.9.2/mythic-bastionland.zip",
  "readme": "README.md",
  "bugs": "https://github.com/PrinceWitherdick/mythic-bastionland-pwd/issues",
  "changelog": "https://github.com/PrinceWitherdick/mythic-bastionland-pwd/releases",
  "relationships": {
    "recommends": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "reason": "Rolls every Save, Attack and table roll as 3D dice on the table."
      },
      {
        "id": "sequencer",
        "type": "module",
        "reason": "Draws Attacks on the map: swords swing, arrows fly, and blood marks whoever loses VIG."
      },
      {
        "id": "JB2A_DnD5e",
        "type": "module",
        "reason": "The animations Sequencer plays for Attacks. The free edition is enough."
      },
      {
        "id": "soundfxlibrary",
        "type": "module",
        "reason": "Gives Attacks their sound, with or without Sequencer."
      },
      {
        "id": "fxmaster",
        "type": "module",
        "reason": "Draws the rolled weather on the Scene the players are on."
      },
      {
        "id": "vtta-tokenizer",
        "type": "module",
        "reason": "Makes map tokens from Knight and NPC portraits."
      }
    ]
  },
  "esmodules": [
    "mythic-bastionland.js"
  ],
  "styles": [
    "styles/mythic-bastionland.css",
    "styles/chat.css",
    "styles/gm-toolkit.css",
    "styles/settings.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "packs": [
    {
      "name": "macros",
      "label": "Mythic Bastionland Macros",
      "path": "packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "documentTypes": {
    "Actor": {
      "knight": {
        "htmlFields": ["notes", "seerInfo", "seerNotes"]
      },
      "npc": {
        "htmlFields": ["notes"]
      },
      "domain": {
        "htmlFields": ["notes"]
      },
      "structure": {
        "htmlFields": ["notes"]
      },
      "gmToolkit": {
        "htmlFields": ["notes"]
      }
    },
    "Item": {
      "weapon": {
        "htmlFields": ["description"]
      },
      "armour": {
        "htmlFields": ["description"]
      },
      "gear": {
        "htmlFields": ["description"]
      },
      "ability": {
        "htmlFields": ["description"]
      },
      "passion": {
        "htmlFields": ["description"]
      },
      "scar": {
        "htmlFields": ["description"]
      }
    }
  },
  "primaryTokenAttribute": "guard",
  "secondaryTokenAttribute": "virtues.vig",
  "socket": true
}
